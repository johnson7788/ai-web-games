{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(1)" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入战斗" },
    { "screenshot": "03-playing.png" },
    { "assert": "window.__ll.run() && window.__ll.run().state.grid.length === 13 && window.__ll.run().state.player.alive === true", "name": "13x13 网格 + 玩家存活" },
    { "eval": "window.__ll.debug.fastForward(3)" },
    { "wait": 300 },
    { "screenshot": "04-combat.png" },
    { "assert": "window.__ll.state.phase === 'playing' || window.__ll.state.phase === 'result'", "name": "推进后仍在战斗或已结算" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.forceWin()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "05-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(1)" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "06-mobile-title.png" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start(1)" },
      { "wait": 700 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入战斗" },
      { "screenshot": "07-mobile-playing.png" },
      { "eval": "window.__ll.debug.fastForward(3)" },
      { "wait": 300 },
      { "screenshot": "08-mobile-combat.png" }
    ]
  }
}
