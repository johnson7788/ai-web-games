{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "eval": "window.__ll.startStage(0)" },
    { "wait": 1200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-jungle.png" },
    { "eval": "window.__ll.demo.pow(3)" },
    { "wait": 700 },
    { "screenshot": "03-pow.png" },
    { "eval": "window.__ll.demo.upgrade()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'upgrade'", "name": "升级屏" },
    { "screenshot": "04-upgrade.png" },
    { "click": ".upgrade-card" },
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'intro'", "name": "升级后进关卡卡" },
    { "screenshot": "05-intro.png" },
    { "eval": "window.__ll.startStage(1)" },
    { "wait": 1200 },
    { "screenshot": "06-river.png" },
    { "eval": "window.__ll.startStage(2)" },
    { "wait": 1200 },
    { "screenshot": "07-desert.png" },
    { "eval": "window.__ll.startStage(3)" },
    { "wait": 1500 },
    { "screenshot": "08-fortress.png" },
    { "eval": "window.__ll.demo.boss()" },
    { "wait": 1600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "Boss 战可玩" },
    { "screenshot": "09-boss.png" },
    { "eval": "window.__ll.demo.dead()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "死亡屏" },
    { "screenshot": "10-dead.png" },
    { "eval": "window.__ll.demo.gameover()" },
    { "wait": 400 },
    { "screenshot": "11-gameover.png" },
    { "eval": "window.__ll.demo.ending()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'ending'", "name": "结局屏" },
    { "screenshot": "12-ending.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回到标题" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.startStage(0)", "prepareWait": 800 },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "screenshot": "13-mobile-title.png" },
      { "eval": "window.__ll.startStage(0)" },
      { "wait": 1200 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端可玩" },
      { "screenshot": "14-mobile-play.png" }
    ]
  }
}
