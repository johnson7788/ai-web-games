{
  "viewport": [1280, 720],
  "steps": [
    {"wait": 900},
    {"screenshot": "01-title.png"},
    {"assert": "window.__ll.state.phase === 'title'", "name": "标题屏"},
    {"assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR"},
    {"assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en"},
    {"eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"},
    {"wait": 200},
    {"assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文"},
    {"screenshot": "01b-title-zh.png"},
    {"assert": "document.getElementById('btn-start').textContent.includes('开始') || document.getElementById('btn-start').textContent.includes('继续')", "name": "中文按钮文案生效"},
    {"eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"},
    {"wait": 200},
    {"assert": "document.documentElement.lang === 'en'", "name": "切回英文"},
    {"eval": "window.__ll.start(1)"},
    {"wait": 500},
    {"assert": "window.__ll.state.phase === 'game'", "name": "进入第 1 关"},
    {"assert": "window.__ll.tutorial.active === true", "name": "首局自动出引导"},
    {"eval": "window.__ll.tutorial.skip()"},
    {"wait": 200},
    {"assert": "window.__ll.tutorial.active === false", "name": "引导可跳过"},
    {"screenshot": "02-level1.png"},
    {"eval": "window.__ll.start(5)"},
    {"wait": 400},
    {"assert": "window.__ll.run.deck.some(c => c.mirrored)", "name": "L5 有镜像卡"},
    {"eval": "window.__ll.start(4)"},
    {"wait": 400},
    {"assert": "window.__ll.run.deck.some(c => c.kind === 'obstacle')", "name": "L4 有障碍卡"},
    {"eval": "window.__ll.start(11)"},
    {"wait": 400},
    {"assert": "(()=>{const m={}; for(const c of window.__ll.run.deck) m[c.char]=(m[c.char]||0)+1; return Object.values(m).some(n=>n===4);})()", "name": "L11 有四张同款"},
    {"eval": "window.__ll.start(2)"},
    {"wait": 400},
    {"screenshot": "03-level2.png"},
    {"eval": "window.__ll.pause()"},
    {"wait": 300},
    {"assert": "window.__ll.state.phase === 'pause'", "name": "暂停"},
    {"eval": "window.__ll.resume()"},
    {"wait": 300},
    {"assert": "window.__ll.state.phase === 'game'", "name": "恢复"},
    {"eval": "(()=>{ document.getElementById('btn-peek').click(); return window.__ll.run.peeksLeft; })()"},
    {"wait": 300},
    {"assert": "window.__ll.run.peeksLeft === 2", "name": "提示消耗一次"},
    {"eval": "window.__ll.restart()"},
    {"wait": 500},
    {"assert": "window.__ll.state.phase === 'title'", "name": "restart 回标题"},
    {"eval": "(()=>{ localStorage.removeItem('blindbox-memory-save'); return true; })()"},
    {"eval": "(()=>{ const p = JSON.parse(localStorage.getItem('blindbox-memory:progress')); return p && typeof p.coins === 'number'; })()", "name": "存档经 SDK 命名空间落盘", "optional": true}
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(6)" }
}
