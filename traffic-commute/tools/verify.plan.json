{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('btn-start') !== null", "name": "开始按钮存在" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 300 },
    { "eval": "window.__ll.tutorial.skip()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入答题" },
    { "assert": "window.__ll.debug.state().questionIndex === 0", "name": "第一题" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.answer()" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().questionIndex === 1", "name": "答对前进" },
    { "screenshot": "03-q2.png" },
    { "eval": "window.__ll.debug.answer()" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().questionIndex === 2", "name": "到第三题" },
    { "screenshot": "04-q3.png" },
    { "eval": "window.__ll.debug.answer()" },
    { "wait": 1600 },
    { "assert": "window.__ll.debug.state().travelerIndex === 1", "name": "切换到 Leo" },
    { "screenshot": "05-rider.png" },
    { "eval": "window.__ll.debug.answer()" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.answer()" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().combo >= 5", "name": "连击累计" },
    { "screenshot": "06-combo.png" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "assert": "window.__ll.debug.state().stars >= 7", "name": "至少 7 星" },
    { "screenshot": "07-result.png" },
    { "eval": "window.__ll.home()" },
    { "wait": 300 },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 300 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "中文进入答题" },
    { "screenshot": "08-zh.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本局" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.startSeeded(0, 3)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动标题屏" },
      { "eval": "window.__ll.debug.startSeeded(0, 5)" },
      { "wait": 400 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动进入答题" },
      { "screenshot": "m-playing.png" }
    ]
  }
}
