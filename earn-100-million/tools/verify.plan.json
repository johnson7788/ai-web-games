{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "eval": "window.__ll.start()" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "assert": "window.__ll.run.state.shownIds.length === 5", "name": "市场展示 5 件商品" },
    { "eval": "(()=>{const r=window.__ll.run; const s=r.state.shownIds.map(id=>r.state.goods.find(g=>g.id===id)).sort((a,b)=>a.marketPrice-b.marketPrice)[0]; return r.buyGoods(s.id, 1).ok;})()" },
    { "assert": "window.__ll.run.state.goods.some(g=>g.ownNum>0)", "name": "买入一件商品入库" },
    { "eval": "window.__ll.run.nextYear()" },
    { "wait": 200 },
    { "assert": "window.__ll.run.state.age === 21", "name": "推进一年年龄 +1" },
    { "screenshot": "04-play.png" },
    { "eval": "window.__ll.debug.winNow()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "触发胜利结算" },
    { "assert": "window.__ll.run.state.summary && window.__ll.run.state.summary.stars >= 4", "name": "胜利至少 4 星" },
    { "screenshot": "05-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开进入 playing" },
    { "eval": "window.__ll.pause()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{document.querySelectorAll('#tabs .tab')[1].click(); return true;})()" },
    { "wait": 300 },
    { "screenshot": "07-business.png" },
    { "eval": "(()=>{document.querySelectorAll('#tabs .tab')[2].click(); return true;})()" },
    { "wait": 300 },
    { "screenshot": "08-lifestyle.png" },
    { "eval": "window.__ll.home()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回到标题" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start()"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 300 },
      { "screenshot": "06-mobile.png" }
    ]
  }
}
