{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "assertVisible": "#hud" },
    { "assert": "window.__ll.sim().floor === 0", "name": "0 层基地" },
    { "screenshot": "02-home.png" },
    { "eval": "window.__ll.debug.loadFloor(1)" },
    { "wait": 300 },
    { "assert": "window.__ll.sim().floor === 1", "name": "第 1 层" },
    { "screenshot": "03-floor1.png" },
    { "eval": "window.__ll.debug.loadFloor(5)" },
    { "wait": 300 },
    { "screenshot": "04-floor5.png" },
    { "eval": "window.__ll.debug.loadFloor(10)" },
    { "wait": 300 },
    { "screenshot": "05-floor10.png" },
    { "eval": "window.__ll.debug.loadFloor(50)" },
    { "wait": 300 },
    { "assert": "window.__ll.sim().floor === 50", "name": "第 50 层 boss" },
    { "screenshot": "06-boss.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.debug.setTutorialDone(true); window.__ll.start()" }
}
