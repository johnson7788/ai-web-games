{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assertVisible": "#lang-select", "name": "语言下拉存在" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 400 },
    { "eval": "(()=>{const el=document.querySelector('[data-tutorial-skip]'); if(el && !el.closest('#tutorial').classList.contains('hidden')) el.click(); return true;})()" },
    { "eval": "window.__ll.debug.stageDemo()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "screenshot": "03-playing.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.forceCombo()" },
    { "wait": 200 },
    { "screenshot": "04-combo.png" },
    { "eval": "window.__ll.debug.forceHit()" },
    { "wait": 200 },
    { "assert": "window.__ll.debug.mode() === 'hit'", "name": "狂暴态" },
    { "screenshot": "05-hit.png" },
    { "eval": "window.__ll.debug.die()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "screenshot": "06-result.png" },
    { "eval": "window.__ll.home()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "07-mobile-title.png" },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题" },
      { "eval": "window.__ll.start()" },
      { "wait": 400 },
      { "eval": "(()=>{const el=document.querySelector('[data-tutorial-skip]'); if(el && !el.closest('#tutorial').classList.contains('hidden')) el.click(); return true;})()" },
      { "eval": "window.__ll.debug.stageDemo()" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "08-mobile-playing.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
