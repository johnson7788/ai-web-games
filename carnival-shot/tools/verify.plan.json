{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 450 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "wait": 1600 },
    { "assert": "window.__ll.run.targets.length > 0", "name": "目标已生成" },
    { "screenshot": "02-play.png" },
    { "eval": "(()=>{const r=window.__ll.run; const t=r.targets.find(t=>!t.dead && t.kind!=='ghost'); if(!t) return false; r.step({shoot:{x:t.x,y:t.y}, reload:false}); return true;})()" },
    { "wait": 120 },
    { "screenshot": "03-hit.png" },
    { "eval": "(()=>{const r=window.__ll.run; r.targets.push({id:r.nextId++,kind:'kite',x:640,y:200,vx:0,vy:0,r:42,fly:'cross',life:5,points:100,dead:false,bornAt:r.time}); r.ammo=100; r.combo=7; r.lastHit=r.time; r.step({shoot:{x:640,y:200}, reload:false}); return true;})()" },
    { "wait": 320 },
    { "screenshot": "04-combo.png" },
    { "eval": "(()=>{const r=window.__ll.run; r.ammo=1; r.step({reload:true}); return r.reloading;})()" },
    { "wait": 160 },
    { "screenshot": "05-reload.png" },
    { "eval": "(()=>{const r=window.__ll.run; for(let i=0;i<4;i++){ r.levelScore=99999; r.levelTime=r.timeLimit; r.step({}); } return r.level;})()" },
    { "wait": 1300 },
    { "assert": "window.__ll.run.level === 5", "name": "跳到河灯场景第 5 关" },
    { "screenshot": "08-scene2.png" },
    { "eval": "(()=>{const r=window.__ll.run; r.levelScore=0; r.levelTime=r.timeLimit; return true;})()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "时间到失败结算" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "06-result.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键一键重开" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "!document.getElementById('btn-reload').hidden", "name": "触屏换弹按钮可见" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "wait": 1500 },
      { "assert": "window.__ll.run.targets.length > 0", "name": "移动端目标生成" },
      { "screenshot": "07-mobile.png" }
    ]
  },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()", "prepareWait": 600 },
  "checks": { "console": true, "failedRequests": true, "external": false }
}
