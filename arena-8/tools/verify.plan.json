{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 400 },
    { "eval": "window.__ll.tutorial.skip()" },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "eval": "window.__AUTO = { mx: 0.6, mz: 0, punch: false, grab: false, ult: false }" },
    { "wait": 1800 },
    { "screenshot": "03-fight.png" },
    { "eval": "window.__AUTO = null" },
    { "wait": 1500 },
    { "eval": "window.__ll.pause()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "04-pause.png" },
    { "eval": "window.__ll.resume()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; r.match=5; r.time=180; r.fighters.forEach(f=>{ if(!f.isPlayer){ f.hp=0; f.alive=true; } }); return true;})()" },
    { "wait": 800 },
    { "assert": "window.__ll.state.phase === 'results'", "name": "强制结算" },
    { "screenshot": "05-results.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "restart 回标题" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
