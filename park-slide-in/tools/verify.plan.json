{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 700 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 3", "name": "关卡格 3 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 500 },
    { "eval": "window.__ll.tutorial.skip()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state().level === 1 && window.__ll.debug.state().bay.w > 120", "name": "L1 车位合法" },
    { "screenshot": "02-l1.png" },
    { "eval": "(()=>{const s=window.__ll.debug.state(); s.car.x=700; s.car.y=360; s.car.heading=0; s.car.speed=0; return true})()" },
    { "wait": 200 },
    { "screenshot": "03-l1-mid.png" },
    { "eval": "window.__ll.debug.loadLevel(1)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().level === 2", "name": "进入第 2 关" },
    { "screenshot": "04-l2.png" },
    { "eval": "(()=>{const s=window.__ll.debug.state(); s.car.x=990; s.car.y=360; s.car.heading=0; s.car.speed=0; return true})()" },
    { "wait": 200 },
    { "screenshot": "05-l2-mid.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().level === 3 && window.__ll.debug.state().moving.length === 1", "name": "L3 有移动障碍" },
    { "screenshot": "06-l3.png" },
    { "eval": "(()=>{const s=window.__ll.debug.state(); s.car.x=760; s.car.y=360; s.car.heading=0; s.car.speed=0; return true})()" },
    { "wait": 200 },
    { "screenshot": "07-l3-mid.png" },
    { "eval": "window.__ll.debug.loadLevel(0)" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.solve()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "自动泊车通关结算" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "至少 1 星" },
    { "screenshot": "08-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 500 },
      { "screenshot": "m1-title.png" },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 400 },
      { "eval": "window.__ll.tutorial.skip()" },
      { "wait": 150 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "m2-playing.png" }
    ]
  }
}
