{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 12", "name": "关卡格 12 个" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state().enemies.length > 0", "name": "有敌人" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.forceLevelUp()" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().phase === 'upgrade'", "name": "升级三选一" },
    { "assertVisible": "#screen-upgrade" },
    { "screenshot": "03-upgrade.png" },
    { "eval": "window.__ll.debug.loadLevel(3)" },
    { "wait": 400 },
    { "eval": "window.__ll.debug.reveal('boss')" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().bossSpawned === true", "name": "Boss 现身" },
    { "screenshot": "04-boss.png" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().sceneKey === 'summer'", "name": "夏泽场景" },
    { "screenshot": "05-summer.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 400 },
    { "eval": "window.__ll.debug.reveal('elite')" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().eliteSpawned === true", "name": "精英现身" },
    { "screenshot": "06-elite.png" },
    { "eval": "window.__ll.debug.loadLevel(8)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().sceneKey === 'autumn'", "name": "秋崖场景" },
    { "screenshot": "07-autumn.png" },
    { "eval": "window.__ll.debug.loadLevel(10)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().narrow === true && window.__ll.debug.state().walls.length > 0", "name": "窄道图" },
    { "screenshot": "08-narrow.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": { "console": true, "failedRequests": false, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" }
}
