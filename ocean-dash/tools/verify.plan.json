{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{localStorage.clear(); return true;})()" },
    { "wait": 400 },
    { "screenshot": "05-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "wait": 1200 },
    { "assert": "window.__ll.run.dist > 100", "name": "自动前进" },
    { "eval": "window.__y0 = window.__ll.run.player.y; window.dispatchEvent(new KeyboardEvent('keydown', {code:'ArrowUp'}));" },
    { "wait": 450 },
    { "screenshot": "01-play.png" },
    { "eval": "window.dispatchEvent(new KeyboardEvent('keyup', {code:'ArrowUp'}));" },
    { "assert": "window.__ll.run.player.y < window.__y0", "name": "上键转向生效" },
    { "eval": "window.dispatchEvent(new KeyboardEvent('keydown', {code:'Space'}));" },
    { "wait": 250 },
    { "assert": "window.__ll.run.gathered === true", "name": "按住空格收拢" },
    { "screenshot": "02-gather.png" },
    { "eval": "window.dispatchEvent(new KeyboardEvent('keyup', {code:'Space'}));" },
    { "wait": 400 },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<60*600&&r.phase==='playing';k++){r.step({steerY:null,gather:false,jump:false,glide:false}); r.drainEvents();} return r.phase;})()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "死亡进入结算" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "06-result.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键重跑" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "!document.getElementById('btn-gather').hidden", "name": "触屏收拢按钮可见" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 400 },
      { "wait": 1500 },
      { "assert": "window.__ll.run.dist > 50", "name": "移动端自动前进" },
      { "screenshot": "04-mobile.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  }
}
