{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 12", "name": "关卡格 12 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "09-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start(0)" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().handLen === 9", "name": "手牌 9 张" },
    { "eval": "(()=>{const r=window.__ll.run(); for(let i=0;i<3 && i<r.state.hand.length;i++) r.selectLetter(i); return true;})()" },
    { "wait": 250 },
    { "screenshot": "03-spelling.png" },
    { "eval": "window.__ll.debug.startSeeded(0, 42)" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.autoSpell()" },
    { "wait": 220 },
    { "screenshot": "04-wordcloud.png" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "screenshot": "07-result.png" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().scene === 1", "name": "午夜竞技场" },
    { "screenshot": "05-scene2.png" },
    { "eval": "window.__ll.debug.loadLevel(8)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().scene === 2", "name": "星陨高塔" },
    { "screenshot": "06-scene3.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.debug.setTutorialDone(true); window.__ll.start(0)" },
  "mobile": {
    "viewport": [960, 540],
    "steps": [
      { "wait": 500 },
      { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start(0)" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入战斗" },
      { "screenshot": "08-mobile.png" }
    ]
  }
}
