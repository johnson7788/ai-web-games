{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(2)" },
    { "wait": 500 },
    { "eval": "window.__ll.tutorial.skip()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 3 关（心形）" },
    { "assert": "window.__ll.run.state.total > 0", "name": "有分格" },
    { "eval": "(()=>{const r=window.__ll.run; r.selectFamily(2); r.selectShade(7); let n=0; for(const reg of r.regions){ if(!reg.locked && n<10){ r.tap(reg.id); n++; } } return n;})()" },
    { "wait": 250 },
    { "screenshot": "02-play.png" },
    { "eval": "(()=>{const r=window.__ll.run; let n=0; for(const reg of r.regions){ if(!reg.locked && !reg.colored && n<14){ r.tap(reg.id); n++; } } return n;})()" },
    { "wait": 250 },
    { "screenshot": "03-fill.png" },
    { "eval": "window.__ll.debug.fillAll()" },
    { "wait": 350 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "通关结算" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "至少 1 星" },
    { "screenshot": "04-result.png" },
    { "eval": "window.__ll.debug.loadLevel(6)" },
    { "wait": 450 },
    { "assert": "window.__ll.debug.regions().some(r=>r.locked)", "name": "L7 有封印格" },
    { "screenshot": "05-rocks.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 450 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": true
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "document.getElementById('rotate-screen') && document.getElementById('btn-rotate-skip')", "name": "竖屏提示元素存在" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" }
    ]
  }
}
