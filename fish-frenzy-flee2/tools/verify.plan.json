{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "typeof window.__ll.startTutorial === 'function' && Array.isArray(window.__ll.tutorial.steps)", "name": "教程契约" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.debug.startSeeded(3)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入对局" },
    { "eval": "(()=>{window.__ll.debug.spawnPreyAt(-50,-40); window.__ll.debug.spawnPredatorAt(240,140,26); window.__ll.debug.spawnRockAt(-280,150,30); window.__ll.debug.fastForward(1.2); return true;})()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state() && window.__ll.debug.state().phase === 'playing'", "name": "对局进行中" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本局" },
    { "eval": "window.__ll.debug.forceGameOver()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "03-result.png" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.debug.startSeeded(1)", "prepareWait": 500 },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 700 },
      { "screenshot": "04-mobile-title.png" },
      { "assert": "window.__ll.state.phase === 'title'", "name": "[mobile] 标题屏" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.debug.startSeeded(5)" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "[mobile] 进入对局" },
      { "screenshot": "05-mobile-play.png" }
    ]
  }
}
