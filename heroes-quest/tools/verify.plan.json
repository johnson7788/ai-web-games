{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文生效" },
    { "screenshot": "v01-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "v02-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "click": "#btn-confirm" },
    { "wait": 300 },
    { "assert": "window.__ll.run.mode === 'map'", "name": "确认布阵进入地图" },
    { "screenshot": "v03-map.png" },
    { "eval": "window.__ll.debug.chooseNode('n1a')" },
    { "wait": 300 },
    { "assert": "window.__ll.run.mode === 'battle'", "name": "选择战斗节点进入战斗" },
    { "screenshot": "v04-battle.png" },
    { "eval": "(()=>{const r=window.__ll.run; let g=0; while(r.mode==='battle' && g++<6000){ if(r.battle.waiting){ if(r.signature>=r.signatureMax) r.step({action:{skill:'signature'}}); else { const t=r.battle.units.filter(u=>u.side==='enemy'&&u.alive).sort((a,b)=>a.hp-b.hp)[0]; r.step({action:{skill:'basic',target:t?t.id:null}}); } } else r.step({}); r.drainEvents(); } return r.mode;})()" },
    { "wait": 300 },
    { "assert": "window.__ll.run.mode === 'upgrade'", "name": "战斗胜利进入升级" },
    { "screenshot": "v05-upgrade.png" },
    { "eval": "window.__ll.debug.upgrade(window.__ll.run.upgradeChoices[0])" },
    { "wait": 300 },
    { "assert": "window.__ll.run.mode === 'map'", "name": "升级后回到地图" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "v06-paused.png" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" },
    { "screenshot": "v07-title.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 400 },
      { "screenshot": "v08-mobile-formation.png" },
      { "click": "#btn-confirm" },
      { "wait": 400 },
      { "assert": "window.__ll.run.mode === 'map'", "name": "移动端进入地图" },
      { "screenshot": "v09-mobile-map.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
