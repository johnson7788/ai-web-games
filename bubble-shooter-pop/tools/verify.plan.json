{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.run.state.wave === 1", "name": "第 1 波" },
    { "eval": "window.__ll.debug.spawnBubble('rock', 640); window.__ll.debug.spawnBubble('gold', 400)" },
    { "wait": 250 },
    { "assert": "window.__ll.run.state.bubbles.length > 0", "name": "有泡泡" },
    { "eval": "window.__ll.debug.spawnPowerup('rapid', 640)" },
    { "wait": 200 },
    { "assert": "window.__ll.run.state.powerups.length > 0", "name": "有道具" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本局" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" },
  "mobile": {
    "viewport": [390, 844],
    "steps": [
      { "wait": 700 },
      { "assertVisible": "#rotate-screen" },
      { "screenshot": "mobile-portrait.png" },
      { "click": "#btn-rotate-skip" },
      { "wait": 250 },
      { "assert": "document.getElementById('rotate-screen').style.display === 'none'", "name": "跳过竖屏提示" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 400 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "mobile-playing.png" }
    ]
  }
}
