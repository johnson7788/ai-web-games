{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 10", "name": "关卡格 10 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.startSeeded(0, 1)" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().tileCount > 0", "name": "牌堆有方块" },
    { "eval": "window.__ll.debug.startSeeded(2, 5)" },
    { "wait": 300 },
    { "eval": "(()=>{const r=window.__ll.run; if(!r||!r._solution) return false; let g=0; while(g<6 && r.state.phase==='playing'){ const s=r._solution[r._solIdx]; if(s===undefined) break; r._solIdx++; const t=r.freeTiles().find(x=>x.symbol===s); if(!t) break; r.pick(t.id); g++; } return true; })()" },
    { "wait": 450 },
    { "assert": "window.__ll.run && window.__ll.run.state.maxCombo >= 2", "name": "触发连击" },
    { "screenshot": "03-combo.png" },
    { "eval": "window.__ll.debug.startSeeded(0, 3)" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.solve()" },
    { "wait": 350 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "通关结算" },
    { "screenshot": "04-result.png" },
    { "assert": "window.__ll.run.state.stars >= 1", "name": "通关至少 1 星" },
    { "eval": "window.__ll.debug.startSeeded(3, 5)" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().rocks > 0", "name": "L4 有岩石" },
    { "screenshot": "05-rocks.png" },
    { "eval": "window.__ll.debug.startSeeded(1, 5)" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().wilds > 0", "name": "L2 有万能" },
    { "screenshot": "06-wilds.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "eval": "window.__ll.debug.startSeeded(0, 9)" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 350 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "超时结算" },
    { "assert": "window.__ll.run.state.result.won === false", "name": "失败结算" },
    { "screenshot": "07-lose.png" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.setTutorialDone(true); window.__ll.debug.startSeeded(0, 1); true"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "mobile 标题" },
      { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.debug.startSeeded(0, 1)" },
      { "wait": 400 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "mobile 进入游戏" }
    ]
  }
}
