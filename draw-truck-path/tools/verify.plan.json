{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state().level === 1 && window.__ll.debug.state().beamCount === 0", "name": "L1 无火花束" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.autoSolve()" },
    { "wait": 4000 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "自动解算到结算" },
    { "screenshot": "03-result.png" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "通关至少 1 星" },
    { "eval": "window.__ll.debug.loadLevel(1)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().level === 2 && window.__ll.debug.state().beamCount === 1", "name": "L2 有火花束" },
    { "screenshot": "04-beam-level.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().level === 3 && window.__ll.debug.state().coreCount === 2", "name": "L3 有双核心" },
    { "screenshot": "05-core-level.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 700 },
      { "screenshot": "06-m-title.png" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 700 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "07-m-playing.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": true
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  }
}
