{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "10-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 3", "name": "关卡格 3 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "11-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state() && window.__ll.debug.state().fruit !== null", "name": "第 1 关有核心" },
    { "screenshot": "01-playing.png" },
    { "eval": "window.__ll.debug.setCombo(4)" },
    { "wait": 200 },
    { "screenshot": "02-combo.png" },
    { "eval": "window.__ll.debug.spawnGolden()" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().goldenActive === true", "name": "黄金核心出现" },
    { "screenshot": "03-golden.png" },
    { "eval": "window.__ll.debug.setSlow(2)" },
    { "wait": 200 },
    { "screenshot": "04-slow.png" },
    { "eval": "window.__ll.debug.loadLevel(0)" },
    { "wait": 400 },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); if(s){s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true}));} return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "游戏中切中文" },
    { "screenshot": "05-playing-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); if(s){s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true}));} return true;})()" },
    { "wait": 250 },
    { "eval": "window.__ll.debug.loadLevel(1)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().wallCount > 0", "name": "L2 有能量墙" },
    { "screenshot": "06-rock.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().wallCount > 10", "name": "L3 墙更多" },
    { "screenshot": "08-rock2.png" },
    { "eval": "window.__ll.debug.winLevel()" },
    { "wait": 450 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "09-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 400 },
      { "assert": "!!document.getElementById('rotate-screen') && !!document.getElementById('btn-rotate-skip') && !!document.getElementById('dpad')", "name": "移动端控件存在" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 600 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "07-mobile.png" }
    ]
  }
}
