{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 600 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().queue.length === 7", "name": "队列 7 张" },
    { "assert": "window.__ll.debug.state().stage === 1", "name": "阶段 1" },
    { "eval": "window.__ll.pause()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.autoPlay(14)" },
    { "wait": 200 },
    { "assert": "window.__ll.debug.state().score > 0", "name": "有得分" },
    { "assert": "window.__ll.debug.state().combo >= 10", "name": "连击 ≥10" },
    { "screenshot": "03-combo.png" },
    { "eval": "window.__ll.debug.autoPlay(16)" },
    { "wait": 200 },
    { "assert": "window.__ll.debug.state().fever === true", "name": "FEVER 触发" },
    { "screenshot": "05-fever.png" },
    { "eval": "(()=>{ window.__ll.debug.setTimeLeft(20); window.__ll.debug.forceRock(); return true; })()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().queue[0].dir === 'rock'", "name": "岩石牌" },
    { "assert": "window.__ll.debug.state().stage === 2", "name": "阶段 2" },
    { "screenshot": "04-rock.png" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "screenshot": "06-result.png" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "至少 1 星" },
    { "eval": "window.__ll.home()" },
    { "wait": 250 },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "screenshot": "08-title-zh.png" },
    { "assert": "document.documentElement.lang === 'zh'", "name": "标题中文" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 400 },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start()" },
      { "wait": 400 },
      { "screenshot": "07-m-playing.png" },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": true
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start()"
  }
}
