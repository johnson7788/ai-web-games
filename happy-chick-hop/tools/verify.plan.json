{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "waitFor": "window.__ll.state.phase === 'playing'", "timeout": 8000 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.drop(200); window.__ll.debug.drop(360); window.__ll.debug.drop(520);" },
    { "wait": 1300 },
    { "screenshot": "03-gameplay.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.fastForwardToWin()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "夺冠结算" },
    { "screenshot": "04-result-win.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开" },
    { "eval": "window.__ll.debug.fastForwardToLose()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "堆满结算" },
    { "screenshot": "05-result-lose.png" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": true
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start()"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "eval": "window.__ll.start()" },
      { "wait": 800 },
      { "eval": "window.__ll.debug.drop(300); window.__ll.debug.drop(420);" },
      { "wait": 1200 },
      { "screenshot": "06-m-playing.png" },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端游戏中" }
    ]
  }
}
