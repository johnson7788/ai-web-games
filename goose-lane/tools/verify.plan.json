{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{const r=window.__ll.run; r.obstacles=[]; r.pickups=[]; r.nextSpawnZ=r.distance+40; return true;})()" },
    { "wait": 1200 },
    { "assert": "window.__ll.run.distance > 5", "name": "自动前进：里程推进" },
    { "press": "ArrowRight" },
    { "wait": 250 },
    { "press": "ArrowLeft" },
    { "wait": 250 },
    { "assert": "[0,1,2].includes(window.__ll.run.lane)", "name": "键盘换道生效" },
    { "screenshot": "04-play.png" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "05-paused.png" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; r.balloons=0; r.obstacles.push({kind:'car', lane:r.lane, z:0.05, resolved:false, dead:false}); for(let k=0;k<5&&r.phase==='playing';k++){r.step({lane:r.lane, stop:false}); r.drainEvents();} return r.phase;})()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'revive'", "name": "首次死亡进入复活" },
    { "assert": "!document.getElementById('screen-revive').classList.contains('hidden')", "name": "复活卡出现" },
    { "screenshot": "06-revive.png" },
    { "click": "#btn-revive" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "复活回到 playing" },
    { "eval": "(()=>{const r=window.__ll.run; r.invulnUntil=-Infinity; r.balloons=0; r.obstacles.push({kind:'car', lane:r.lane, z:0.05, resolved:false, dead:false}); for(let k=0;k<5&&r.phase==='playing';k++){r.step({lane:r.lane, stop:false}); r.drainEvents();} return r.phase;})()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "二次死亡进结算" },
    { "assert": "!document.getElementById('screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "07-dead.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键重开" },
    { "assert": "(()=>{const v=window.PipyGames; return !v || typeof v.track==='function' || true;})()", "name": "SDK 存在或降级不崩" },
    { "screenshot": "08-restart.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "!document.getElementById('btn-stop').hidden", "name": "触屏停步按钮可见" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "wait": 1500 },
      { "assert": "window.__ll.run.distance > 2", "name": "移动端里程推进" },
      { "screenshot": "09-mobile-play.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start()",
    "prepareWait": 400
  }
}
