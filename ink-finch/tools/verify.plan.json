{
  "viewport": [
    1280,
    720
  ],
  "steps": [
    {
      "wait": 800
    },
    {
      "screenshot": "01-title.png"
    },
    {
      "assert": "window.__ll.state.phase === 'title'",
      "name": "标题屏"
    },
    {
      "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'",
      "name": "默认英文/LTR"
    },
    {
      "assert": "document.getElementById('level-grid').children.length === 12",
      "name": "关卡格 12 个"
    },
    {
      "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"
    },
    {
      "wait": 250
    },
    {
      "assert": "document.documentElement.lang === 'zh'",
      "name": "切中文"
    },
    {
      "screenshot": "01b-title-zh.png"
    },
    {
      "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"
    },
    {
      "wait": 250
    },
    {
      "assert": "document.documentElement.lang === 'en'",
      "name": "切回英文"
    },
    {
      "eval": "window.__ll.debug.setTutorialDone(true)"
    },
    {
      "eval": "window.__ll.debug.startSeeded(1, 3)"
    },
    {
      "wait": 700
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "进入第 1 关"
    },
    {
      "screenshot": "02-playing.png"
    },
    {
      "assert": "window.__ll.debug.state().gates.length > 0",
      "name": "竹节已生成"
    },
    {
      "eval": "window.__ll.debug.autoPlay()"
    },
    {
      "wait": 400
    },
    {
      "assert": "window.__ll.state.phase === 'result'",
      "name": "自动通关结算"
    },
    {
      "screenshot": "03-result.png"
    },
    {
      "eval": "window.__ll.debug.loadLevel(4)"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.debug.state().level === 4",
      "name": "进入气流关 L4"
    },
    {
      "screenshot": "04-updraft.png"
    },
    {
      "eval": "window.__ll.debug.loadLevel(6)"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.debug.state().level === 6",
      "name": "进入双缝关 L6"
    },
    {
      "screenshot": "05-double-gap.png"
    },
    {
      "eval": "window.__ll.debug.loadLevel(7)"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.debug.state().level === 7",
      "name": "进入转轮关 L7"
    },
    {
      "screenshot": "06-wheel.png"
    },
    {
      "eval": "window.__ll.debug.loadLevel(9)"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.debug.state().level === 9",
      "name": "进入雪竹关 L9"
    },
    {
      "screenshot": "07-snow.png"
    },
    {
      "eval": "window.__ll.pause()"
    },
    {
      "wait": 250
    },
    {
      "assert": "window.__ll.state.phase === 'paused'",
      "name": "暂停"
    },
    {
      "eval": "window.__ll.resume()"
    },
    {
      "wait": 250
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "恢复"
    },
    {
      "eval": "window.__ll.restart()"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "重开本关"
    }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(1)"
  },
  "mobile": {
    "viewport": [
      844,
      390
    ],
    "steps": [
      {
        "eval": "window.__ll.debug.setTutorialDone(true)"
      },
      {
        "eval": "window.__ll.debug.startSeeded(1, 3)"
      },
      {
        "wait": 600
      },
      {
        "screenshot": "08-m-playing.png"
      },
      {
        "assert": "window.__ll.state.phase === 'playing'",
        "name": "移动端进入游戏"
      }
    ]
  }
}