{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "eval": "window.__ll.tutorial.skip()", "name": "跳过首玩教程" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "assert": "window.__ll.debug.state().total === 10", "name": "共 10 题" },
    { "screenshot": "03-playing.png" },
    { "eval": "(()=>{const d=window.__ll.debug; for(let i=0;i<3 && window.__ll.state.phase==='playing';i++){d.answer(d.currentAnswer());} return true;})()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().round === 2", "name": "推进到第 2 关" },
    { "screenshot": "04-round2.png" },
    { "eval": "(()=>{const d=window.__ll.debug; for(let i=0;i<3 && window.__ll.state.phase==='playing';i++){d.answer(d.currentAnswer());} return true;})()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().round === 3", "name": "推进到第 3 关" },
    { "screenshot": "05-round3.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.win()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "通关结算" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "至少 1 星" },
    { "screenshot": "06-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "一键重开" },
    { "screenshot": "07-restart.png" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "[mobile] 标题屏" },
      { "eval": "window.__ll.start()" },
      { "wait": 400 },
      { "eval": "window.__ll.tutorial.skip()" },
      { "wait": 200 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "[mobile] 进入游戏" },
      { "screenshot": "08-mobile.png" }
    ]
  }
}
