{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 4", "name": "关卡格 4 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.carveRect(600, 140, 680, 340)" },
    { "wait": 700 },
    { "screenshot": "03-carving.png" },
    { "eval": "window.__ll.debug.carveRect(600, 140, 680, 604)" },
    { "wait": 2000 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "钻核进传送门结算" },
    { "screenshot": "04-result.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 600 },
    { "assert": "window.__ll.debug.state().level.index === 2", "name": "第 3 关有岩石" },
    { "screenshot": "05-rock-level.png" },
    { "eval": "window.__ll.debug.loadLevel(3)" },
    { "wait": 600 },
    { "screenshot": "08-deep-core.png" },
    { "eval": "window.__ll.debug.loadLevel(0)" },
    { "wait": 300 },
    { "eval": "window.__ll.setLang('zh')" },
    { "wait": 300 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "游戏内切中文" },
    { "screenshot": "07-zh-playing.png" },
    { "eval": "window.__ll.setLang('en')" },
    { "wait": 200 },
    { "eval": "window.__ll.pause()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "eval": "window.__ll.start(0)" },
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "06-mobile-playing.png" }
    ]
  }
}
