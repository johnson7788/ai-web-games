{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 3", "name": "3 个关卡格" },
    { "eval": "(function(){var s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(function(){var s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.build(0,'laser'); window.__ll.debug.build(6,'laser'); window.__ll.debug.build(12,'rail')" },
    { "assert": "window.__ll.debug.state().towers.length === 3", "name": "建了 3 座塔" },
    { "wait": 4000 },
    { "screenshot": "03-combat.png" },
    { "assert": "window.__ll.debug.state().killCount > 0 || window.__ll.debug.state().enemies.length > 0", "name": "有敌人或击杀" },
    { "eval": "window.__ll.debug.autoWin()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "进入结算" },
    { "screenshot": "04-result.png" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "通关至少 1 星" },
    { "eval": "window.__ll.debug.startSeeded(1, 5)" },
    { "wait": 1800 },
    { "assert": "window.__ll.run().buildSpots().filter(function(s){return s.blocked}).length > 0", "name": "L2 有岩石封锁" },
    { "screenshot": "05-rock-level.png" },
    { "eval": "window.__ll.debug.startSeeded(2, 5)" },
    { "wait": 1800 },
    { "assert": "window.__ll.debug.state().level === 3", "name": "L3 已进入" },
    { "screenshot": "06-boss-level.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 1200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "screenshot": "07-restart.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "screenshot": "08-mobile.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" }
}
