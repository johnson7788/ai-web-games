{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{localStorage.clear(); return true;})()" },
    { "eval": "window.location.reload()" },
    { "wait": 1200 },
    { "screenshot": "09-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文生效" },
    { "screenshot": "10-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "wait": 2200 },
    { "assert": "window.__ll.run.distance > 100", "name": "自动前进推进" },
    { "screenshot": "01-play.png" },
    { "eval": "window.__ll.debug.testJump()" },
    { "assert": "window.__ll.run.egg.y < 580", "name": "蓄力跳跃离地" },
    { "wait": 900 },
    { "screenshot": "02-shoot.png" },
    { "eval": "window.__ll.debug.jumpLevel(5)" },
    { "wait": 800 },
    { "assert": "window.__ll.run.scene === 'dessert'", "name": "切到甜品站场景" },
    { "screenshot": "07-scene2.png" },
    { "eval": "window.__ll.debug.jumpLevel(9)" },
    { "wait": 800 },
    { "assert": "window.__ll.run.scene === 'canteen'", "name": "切到午夜食堂场景" },
    { "screenshot": "08-scene3.png" },
    { "eval": "(()=>{const r=window.__ll.run; r.egg.shell=0; for(let k=0;k<60*240&&r.phase==='playing';k++){r.step({}); r.drainEvents();} return r.phase;})()" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "无壳碰撞死亡" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "05-dead.png" },
    { "press": "KeyR" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键重开" },
    { "screenshot": "06-restart.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 600 },
      { "click": "[data-tutorial-skip]" },
      { "wait": 1300 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "assert": "window.__ll.run.distance > 60", "name": "移动端自动前进" },
      { "screenshot": "04-mobile.png" }
    ]
  },
  "fps": { "enabled": true, "min": 50 },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  }
}
