{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "!!document.getElementById('rotate-screen') && !!document.getElementById('btn-rotate-skip')", "name": "竖屏提示节点存在" },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "eval": "window.__ll.pause()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.debug.spawnShowcase()" },
    { "wait": 300 },
    { "screenshot": "02-battle.png" },
    { "eval": "(()=>{const r=window.__ll.run(); r.state.enemies.length=0; const mk=(t,x,y)=>({x,y,xSpeed:0,dir:1,type:t,hp:1,fireTimer:999,burst:false,burstCount:0,burstTimer:0,canFire:false}); r.state.enemies.push(mk('small',400,150),mk('medium',640,120),mk('small',880,170)); r.state.asteroids.push({x:640,y:320,vx:40,vy:80,rot:1,dir:-1}); r.state.powerups.push({x:500,y:110}); r.state.lasers.push({x:400,y:380,vx:0,vy:-1400},{x:640,y:420,vx:0,vy:-1400},{x:880,y:360,vx:0,vy:-1400}); return true;})()" },
    { "wait": 300 },
    { "screenshot": "03-battle2.png" },
    { "eval": "window.__ll.debug.giveUp()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "04-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "05-m-title.png" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start()" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "eval": "window.__ll.debug.spawnShowcase()" },
      { "wait": 300 },
      { "screenshot": "06-m-playing.png" }
    ]
  }
}
