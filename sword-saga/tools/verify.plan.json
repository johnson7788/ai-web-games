{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{localStorage.clear(); return true;})()" },
    { "eval": "window.location.reload()" },
    { "wait": 1200 },
    { "screenshot": "v01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "v02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "v03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{window.dispatchEvent(new KeyboardEvent('keydown',{code:'ArrowRight'})); return true;})()" },
    { "wait": 1500 },
    { "eval": "(()=>{window.dispatchEvent(new KeyboardEvent('keyup',{code:'ArrowRight'})); return true;})()" },
    { "wait": 400 },
    { "assert": "window.__ll.run.mode === 'dialog' || window.__ll.run.map.openingDone === true", "name": "走向长老触发对话" },
    { "screenshot": "v04-dialog.png" },
    { "eval": "(()=>{const r=window.__ll.run; let g=0; while(r.mode==='dialog' && g<40){r.step({advance:true}); r.drainEvents(); g++;} return r.mode;})()" },
    { "eval": "(()=>{const r=window.__ll.run; r.map.px=20; r.map.py=7; r.step({}); return true;})()" },
    { "wait": 1600 },
    { "assert": "window.__ll.run.mode === 'battle' && window.__ll.run.battle && window.__ll.run.battle.pending === 'hero'", "name": "进入战斗且轮到剑客" },
    { "screenshot": "v05-battle.png" },
    { "click": "[data-action=\"attack\"]" },
    { "wait": 300 },
    { "click": "[data-target=\"enemy0\"]" },
    { "wait": 700 },
    { "assert": "window.__ll.run.mode === 'battle'", "name": "普攻后战斗继续" },
    { "eval": "(()=>{const r=window.__ll.run; let g=0; while(r.mode==='battle' && r.phase==='playing' && g<3000){r.step({menu: r.battle && r.battle.pending ? {type:'attack', target: (r.battle.units.find(u=>u.side==='enemy'&&u.alive)||{}).id} : null}); r.drainEvents(); g++;} return r.mode;})()" },
    { "eval": "(()=>{const r=window.__ll.run; let g=0; while(r.mode==='dialog' && g<40){r.step({advance:true}); r.drainEvents(); g++;} return r.chapter;})()" },
    { "assert": "window.__ll.run.chapter === 2", "name": "首战胜利推进到第 2 章" },
    { "screenshot": "v06-chapter2.png" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "v07-paused.png" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "assert": "(()=>{const v=window.PipyGames; return !v || typeof v.track==='function' || true;})()", "name": "SDK 存在或降级不崩" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "assert": "!!document.querySelector('[data-tutorial]')", "name": "移动端引导层存在" },
      { "screenshot": "v08-mobile.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  }
}
