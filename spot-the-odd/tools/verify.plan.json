{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 700 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "09-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "assert": "window.__ll.run.items.length === 25", "name": "25 个物品" },
    { "screenshot": "02-playing.png" },
    { "eval": "(()=>{const r=window.__ll.run; const i=r.items.findIndex(it=>it.cat===r.task.cat && !it.collected && !it.odd); r.tap(i); return true;})()" },
    { "wait": 300 },
    { "assert": "window.__ll.run.task.found >= 1", "name": "点对推进进度" },
    { "screenshot": "03-correct.png" },
    { "eval": "(()=>{const r=window.__ll.run; const i=r.items.findIndex(it=>it.odd && !it.oddResolved); r.tap(i); return true;})()" },
    { "wait": 300 },
    { "assert": "window.__ll.run.oddFoundTotal >= 1", "name": "点中异类" },
    { "screenshot": "04-odd.png" },
    { "eval": "(()=>{const r=window.__ll.run; const need=r.task.need - r.task.found; for(let k=0;k<need;k++){ const i=r.items.findIndex(it=>it.cat===r.task.cat && !it.collected && !it.odd); if(i<0) break; r.tap(i);} return true;})()" },
    { "wait": 400 },
    { "assert": "window.__ll.run.round >= 2", "name": "完成回合推进" },
    { "screenshot": "05-round2.png" },
    { "eval": "(()=>{const r=window.__ll.run; const h=r.hint(); return !!h.ok;})()" },
    { "wait": 350 },
    { "assert": "window.__ll.run.hintIndex != null", "name": "提示高亮" },
    { "screenshot": "08-hint.png" },
    { "eval": "window.__ll.debug.solve()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "screenshot": "06-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开进入游戏" },
    { "screenshot": "07-replay.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题" },
      { "screenshot": "10-mobile-title.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
