{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "v02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "v03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{window.dispatchEvent(new KeyboardEvent('keydown',{code:'ArrowUp'})); return true;})()" },
    { "wait": 1200 },
    { "assert": "window.__ll.run.speed > 0", "name": "油门推进" },
    { "eval": "window.dispatchEvent(new KeyboardEvent('keyup',{code:'ArrowUp'}))" },
    { "eval": "(()=>{window.dispatchEvent(new KeyboardEvent('keydown',{code:'ArrowRight'})); return true;})()" },
    { "wait": 400 },
    { "eval": "window.dispatchEvent(new KeyboardEvent('keyup',{code:'ArrowRight'}))" },
    { "assert": "Math.abs(window.__ll.run.playerX) > 0", "name": "转向生效" },
    { "screenshot": "v04-play.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "v05-paused.png" },
    { "eval": "window.__ll.resume()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<60*60&&r.phase==='playing';k++){r.step({steer:0,throttle:0,brake:0,tune:false}); r.drainEvents();} return r.phase;})()" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "超时 DNF" },
    { "assert": "!document.getElementById('screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "v06-dead.png" },
    { "eval": "(()=>{window.dispatchEvent(new KeyboardEvent('keydown',{code:'KeyR'})); return true;})()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键重开" },
    { "screenshot": "v07-restart.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "getComputedStyle(document.getElementById('btn-gas')).display !== 'none'", "name": "触屏油门按钮可见" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 300 },
      { "eval": "(()=>{const b=document.getElementById('btn-gas'); b.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true})); return true;})()" },
      { "wait": 900 },
      { "eval": "(()=>{const b=document.getElementById('btn-gas'); b.dispatchEvent(new PointerEvent('pointerup',{bubbles:true})); return true;})()" },
      { "assert": "window.__ll.run.speed > 0", "name": "触屏油门推进" },
      { "screenshot": "v08-mobile-play.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
