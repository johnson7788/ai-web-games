{
  "viewport": [1280, 720],
  "steps": [
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.startSeeded(0, 2)" },
    { "wait": 4500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state().level === 1", "name": "第 1 关" },
    { "assert": "window.__ll.debug.state().player.hp > 0", "name": "玩家存活" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.startSeeded(1, 2)" },
    { "wait": 4500 },
    { "assert": "window.__ll.debug.state().level === 2", "name": "第 2 关（小行星带）" },
    { "screenshot": "03-asteroid.png" },
    { "eval": "window.__ll.debug.startSeeded(2, 2)" },
    { "wait": 4500 },
    { "assert": "window.__ll.debug.state().level === 3", "name": "第 3 关（连击）" },
    { "screenshot": "04-wave.png" },
    { "eval": "window.__ll.debug.startSeeded(3, 2)" },
    { "wait": 4500 },
    { "assert": "window.__ll.debug.state().level === 4", "name": "第 4 关（岩石风暴）" },
    { "screenshot": "07-rockstorm.png" },
    { "eval": "window.__ll.debug.startSeeded(5, 2)" },
    { "wait": 4500 },
    { "assert": "window.__ll.debug.state().level === 6", "name": "第 6 关（最终突袭）" },
    { "screenshot": "08-final.png" },
    { "eval": "window.__ll.debug.loadLevel(0)" },
    { "wait": 400 },
    { "eval": "window.__ll.debug.forceWin()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "通关至少 1 星" },
    { "screenshot": "05-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "eval": "window.__ll.debug.startSeeded(0, 5)" },
      { "wait": 4500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "06-m-playing.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  }
}
