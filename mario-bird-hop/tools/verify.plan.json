{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "eval": "window.__ll.start(0)" },
    { "wait": 400 },
    { "eval": "window.__ll.tutorial.skip()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.run() !== null", "name": "run 已创建" },
    { "eval": "window.__ll.debug.win()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "03-result.png" },
    { "eval": "window.__ll.start(1)" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 2 关" },
    { "screenshot": "04-level2.png" },
    { "eval": "window.__ll.start(2)" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 3 关" },
    { "screenshot": "05-level3.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 400 },
      { "eval": "window.__ll.start(0)" },
      { "wait": 400 },
      { "eval": "window.__ll.tutorial.skip()" },
      { "wait": 300 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "06-mobile-playing.png" },
      { "assertVisible": "#btn-left" },
      { "assertVisible": "#btn-jump" },
      { "setViewport": { "w": 390, "h": 844 } },
      { "wait": 300 },
      { "assert": "getComputedStyle(document.getElementById('rotate-screen')).display !== 'none'", "name": "竖屏提示显示" },
      { "eval": "document.getElementById('btn-rotate-skip').click()" },
      { "wait": 200 },
      { "assert": "document.getElementById('rotate-screen').style.display === 'none'", "name": "跳过竖屏提示" }
    ]
  }
}
