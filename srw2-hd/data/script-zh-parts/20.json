{
 "title": "第２０話　「決戦！！グラナダ要塞」",
 "titleZh": "第20话「决战!!格拉纳达要塞」",
 "lines": [
  {"section": "【マップ】", "sectionZh": "【战场】"},
  {"section": "「１ターン目　ＥＰ」", "sectionZh": "「第1回合 敌方回合」"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "あの　あおいロボットは！", "textZh": "那台蓝色的机器人是！"},
  {"who": "マサキ", "whoZh": "正树", "text": "シュウ！！", "textZh": "修！！"},
  {"who": "マサキ", "whoZh": "正树", "text": "きさま　こんなところに！！」", "textZh": "你这家伙，竟在这里！！"},
  {"who": "シュウ", "whoZh": "修", "text": "ほう・・マサキですか", "textZh": "哦……是正树啊"},
  {"who": "シュウ", "whoZh": "修", "text": "これは　きぐうですね　いつからあなたは", "textZh": "真是巧遇啊，你什么时候"},
  {"who": "シュウ", "whoZh": "修", "text": "むれを　なすようになりました？", "textZh": "也成群结队了？"},
  {"who": "シュウ", "whoZh": "修", "text": "いっぴきおおかみを　きどって", "textZh": "你不是一直以"},
  {"who": "シュウ", "whoZh": "修", "text": "いたのでは　ありませんか？」", "textZh": "孤狼自居吗？"},
  {"who": "マサキ", "whoZh": "正树", "text": "きさまこそ", "textZh": "你才是"},
  {"who": "マサキ", "whoZh": "正树", "text": "なにを　かんがえている！？", "textZh": "在打什么主意！？"},
  {"who": "マサキ", "whoZh": "正树", "text": "Ｄ・Ｃに　きょうりょくするなんて！", "textZh": "居然和D·C合作！"},
  {"who": "シュウ", "whoZh": "修", "text": "はなしたところで", "textZh": "就算我说了"},
  {"who": "シュウ", "whoZh": "修", "text": "わたしのかんがえが　あなたに", "textZh": "我的想法，你"},
  {"who": "シュウ", "whoZh": "修", "text": "りかいできるとは　おもえませんね", "textZh": "恐怕也理解不了"},
  {"who": "シュウ", "whoZh": "修", "text": "それより　そこのかたがたに", "textZh": "比起这个，能否给"},
  {"who": "シュウ", "whoZh": "修", "text": "しょうかいして　いただけませんか", "textZh": "那边诸位介绍一下"},
  {"who": "シュウ", "whoZh": "修", "text": "なにしろ　しょたいめんの", "textZh": "毕竟有初次"},
  {"who": "シュウ", "whoZh": "修", "text": "かたが　いらっしゃるようですから」", "textZh": "见面的人在"},
  {"who": "マサキ", "whoZh": "正树", "text": "ふん！！　じぶんでやりな！！」", "textZh": "哼！！你自己来！！"},
  {"who": "シュウ", "whoZh": "修", "text": "そうですか　しかたありませんね", "textZh": "是吗，没办法呢"},
  {"who": "シュウ", "whoZh": "修", "text": "わたしのなは　シュウ＝シラカワ", "textZh": "我叫修·白河"},
  {"who": "シュウ", "whoZh": "修", "text": "そして　わたしのあいき　グランゾンです", "textZh": "这是我的爱机，古兰森"},
  {"who": "シュウ", "whoZh": "修", "text": "こういうかたちで　であわねば", "textZh": "不得以这种方式"},
  {"who": "シュウ", "whoZh": "修", "text": "ならないとは　ふこうではありますが・・・", "textZh": "相遇，实属不幸……"},
  {"who": "シュウ", "whoZh": "修", "text": "これも　おたがいの", "textZh": "但这也不过是"},
  {"who": "シュウ", "whoZh": "修", "text": "つごうというもの　ごかんべんねがいます", "textZh": "彼此的立场所致，还请见谅"},
  {"who": "シュウ", "whoZh": "修", "text": "あなたがたの　ごこうめいは", "textZh": "诸位的赫赫威名"},
  {"who": "シュウ", "whoZh": "修", "text": "ききおよんでいますよ", "textZh": "我早有耳闻"},
  {"who": "シュウ", "whoZh": "修", "text": "いちど　おてあわせしたいと", "textZh": "一直想讨教"},
  {"who": "シュウ", "whoZh": "修", "text": "おもっていました　ごえんりょなく", "textZh": "一番，请不必客气"},
  {"who": "シュウ", "whoZh": "修", "text": "かかってきてください」", "textZh": "放马过来吧"},
  {"who": "竜馬", "whoZh": "龙马", "text": "ハヤトより　キザなやつなんて", "textZh": "比隼人还装腔作势的家伙"},
  {"who": "竜馬", "whoZh": "龙马", "text": "はじめてみたぜ・・・」", "textZh": "我还是第一次见……"},
  {"section": "「７ターン目　ＥＰ」", "sectionZh": "「第7回合 敌方回合」"},
  {"who": "シュウ", "whoZh": "修", "text": "さすが・・・　ですね", "textZh": "不愧是……啊"},
  {"who": "シュウ", "whoZh": "修", "text": "これほどとは　おもいませんでした", "textZh": "没想到你们到这种程度"},
  {"who": "シュウ", "whoZh": "修", "text": "そのちからに　けいいを", "textZh": "向你们的力量致敬"},
  {"who": "シュウ", "whoZh": "修", "text": "ひょうして　こんかいは　ひきあげさせて", "textZh": "这次就先行"},
  {"who": "シュウ", "whoZh": "修", "text": "いただきましょう", "textZh": "告退了"},
  {"who": "シュウ", "whoZh": "修", "text": "そうそう　これだけは", "textZh": "对了，只有这个"},
  {"who": "シュウ", "whoZh": "修", "text": "おぼえておいて　ください", "textZh": "请务必记住"},
  {"who": "シュウ", "whoZh": "修", "text": "あなたがたは　いまはまだ", "textZh": "你们现在，仍不过是"},
  {"who": "シュウ", "whoZh": "修", "text": "ビアンそうすいの　てのひらのうえで", "textZh": "在比安总司令的"},
  {"who": "シュウ", "whoZh": "修", "text": "おどっているにすぎません", "textZh": "掌心里跳舞而已"},
  {"who": "シュウ", "whoZh": "修", "text": "これから　おおいなる", "textZh": "今后，还会有"},
  {"who": "シュウ", "whoZh": "修", "text": "しれんが　あるでしょう", "textZh": "巨大的试炼"},
  {"who": "シュウ", "whoZh": "修", "text": "しかし　それをのりこえれば・・・", "textZh": "但只要跨越它……"},
  {"who": "シュウ", "whoZh": "修", "text": "まあ　せいぜい", "textZh": "嘛，总之"},
  {"who": "シュウ", "whoZh": "修", "text": "がんばることですね", "textZh": "好好努力吧"},
  {"section": "「戦闘終了後」", "sectionZh": "「战斗结束后」"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "カミーユ　きみが　いぜん", "textZh": "卡缪，你之前"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "たたかって　やぶれたあいてというのは", "textZh": "交战落败的对手，就是"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "やはりあの・・・」", "textZh": "果然那个……"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "ええ・・・", "textZh": "嗯……"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "グランゾンのシュウ・・・", "textZh": "古兰森的修……"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "てごわい　あいてです」", "textZh": "是个难缠的对手"},
  {"who": "甲児", "whoZh": "甲儿", "text": "それにしてもよ　なんだろうな", "textZh": "话说回来，那家伙"},
  {"who": "甲児", "whoZh": "甲儿", "text": "あの　いみありげなセリフは」", "textZh": "那意味深长的台词是啥啊"},
  {"who": "マサキ", "whoZh": "正树", "text": "フン　はったりさ", "textZh": "哼，虚张声势罢了"},
  {"who": "マサキ", "whoZh": "正树", "text": "あいつの　いつものクセだよ", "textZh": "那是他一贯的毛病"},
  {"who": "マサキ", "whoZh": "正树", "text": "よゆー　かましやがって」", "textZh": "还摆出一副游刃有余的样子"}
 ]
}
