  {"section": "【インターミッション】", "sectionZh": "【幕间】"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "なるほど　たしかに", "textZh": "原来如此，确实"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "このルートは　てきのぼうえいせんも", "textZh": "这条路线的敌方防线"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "てうすになっているようだ」", "textZh": "看来兵力薄弱"},
  {"who": "ファ", "whoZh": "花", "text": "ぜんぽうに　てきえいかくにん！", "textZh": "前方确认敌影！"},
  {"who": "ファ", "whoZh": "花", "text": "きすうは　やく　１０！」", "textZh": "数量约10台！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "よし　きょうこうとっぱを", "textZh": "好，强行"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "かける！」", "textZh": "突破！"},
  {"section": "【マップ】", "sectionZh": "【战场】"},
  {"section": "「１ターン目」", "sectionZh": "「第1回合」"},
  {"who": "プル", "whoZh": "普露", "text": "・・・・！？", "textZh": "……！？"},
  {"who": "プル", "whoZh": "普露", "text": "なに！？　これ？", "textZh": "什么！？这是？"},
  {"who": "プル", "whoZh": "普露", "text": "きもちがわるい・・・・」", "textZh": "感觉好难受……"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "？　どうした？　プル」", "textZh": "？怎么了？普露"},
  {"who": "プル", "whoZh": "普露", "text": "・・・わかんない・・・", "textZh": "……不知道……"},
  {"who": "プル", "whoZh": "普露", "text": "でも　なんだろう　これ・・・」", "textZh": "但这是怎么回事……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "・・・この　ふかいかん・・", "textZh": "……这种不快感……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "なんだ・・・プル？」", "textZh": "是什么……普露？"},
  {"who": "ハマーン", "whoZh": "哈曼", "text": "ふむ　どうやら　プルが", "textZh": "唔，看来普露"},
  {"who": "ハマーン", "whoZh": "哈曼", "text": "あのなかに　いるようだな・・・", "textZh": "就在那里面……"},
  {"who": "ハマーン", "whoZh": "哈曼", "text": "プルツーよ", "textZh": "普露兹啊"},
  {"who": "ハマーン", "whoZh": "哈曼", "text": "うらぎりもの　プルをころせ！！」", "textZh": "把叛徒普露杀掉！！"},
  {"section": "「プルツーが移動する」", "sectionZh": "「普露兹移动」"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "なんなんだ・・・・", "textZh": "这到底是什么……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "この　ふかいかんは・・・？」", "textZh": "这种不快感……？"},
  {"section": "「プルツーがプルに攻撃する」", "sectionZh": "「普露兹攻击普露」"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "なんだ！？　こいつ・・・", "textZh": "什么！？这家伙……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "わたしと　おなじことを　かんがえている？", "textZh": "在想和我一样的事？"},
  {"who": "プル", "whoZh": "普露", "text": "わかったわ・・・　あなたは　あたしね", "textZh": "我知道了……你就是我呢"},
  {"who": "プル", "whoZh": "普露", "text": "あなたは　あたしの　はげしいところだけを", "textZh": "你只带着我"},
  {"who": "プル", "whoZh": "普露", "text": "もっている・・・」", "textZh": "狂暴的那一面……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "こいつ・・・　ふゆかい", "textZh": "这家伙……真让人不快"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "なんだよ！！」", "textZh": "什么啊！！"},
  {"who": "プル", "whoZh": "普露", "text": "おしえてあげる　ひとはね", "textZh": "我来告诉你，人呐"},
  {"who": "プル", "whoZh": "普露", "text": "じぶんのすがたを　うつしだされるのが", "textZh": "被映出自己的样子"},
  {"who": "プル", "whoZh": "普露", "text": "いやなのよ", "textZh": "是会讨厌的"},
  {"who": "プル", "whoZh": "普露", "text": "あなたは　あたしよ！」", "textZh": "你就是我！"},
  {"section": "「プルがプルツーに殺された場合」", "sectionZh": "「普露被普露兹杀死的情况」"},
  {"who": "プル", "whoZh": "普露", "text": "きゃああああっ！！", "textZh": "呀啊啊啊！！"},
  {"who": "プル", "whoZh": "普露", "text": "ジュドーーーーッ！！」", "textZh": "捷多——！！"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "うくっ！！　な・なんだ・・", "textZh": "呜！什、什么……"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "あたまが・・・きもちがわるい・・・」", "textZh": "头……好难受……"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "え・・・？　プル！！", "textZh": "诶……？普露！！"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "プルゥーーーーッ！！", "textZh": "普露——！！"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "てめえっ！！　よくも・・・", "textZh": "你这家伙！！竟敢……"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "！！！　なんだ！？　おまえ・・・", "textZh": "！！！什么！？你……"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "プル・・・・！？", "textZh": "普露……！？"},
  {"who": "プルツー", "whoZh": "普露兹", "text": "つぎは　おまえか！？", "textZh": "下一个是你吗！？"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "な・・・なんだ　プル・・・", "textZh": "什……什么，普露……"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "い　いや　ちがう・・・でも", "textZh": "不、不对……但是"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "プルは・・・プルに", "textZh": "普露她……被普露"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "ころされた・・・？」", "textZh": "杀了……？"}
