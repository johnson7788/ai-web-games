{
 "title": "第１８話　「潜入！コンペトー」",
 "titleZh": "第18话「潜入！康佩特」",
 "lines": [
  {"section": "【インターミッション】", "sectionZh": "【幕间】"},
  {"who": "ファ", "whoZh": "花", "text": "こうねつげんたい", "textZh": "高热源体"},
  {"who": "ファ", "whoZh": "花", "text": "たすうせっきんしています！！」", "textZh": "大量接近中！！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "ミサイルか！？", "textZh": "是导弹吗！？"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "アンチミサイルはっしゃ！！」", "textZh": "发射反导弹！！"},
  {"who": "ファ", "whoZh": "花", "text": "だめです！　まにあいません！", "textZh": "不行！来不及了！"},
  {"who": "ファ", "whoZh": "花", "text": "きゃあっ！！」", "textZh": "呀啊！！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "くっ！", "textZh": "呜！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "だい２はがくるぞ！", "textZh": "第二波要来了！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "そういんせんとうはいち！」", "textZh": "全员战斗配置！"},
  {"who": "ファ", "whoZh": "花", "text": "ロボットらしき", "textZh": "像是机器人的东西"},
  {"who": "ファ", "whoZh": "花", "text": "こうねつげんたいせっきん！", "textZh": "高热源体接近！"},
  {"who": "ファ", "whoZh": "花", "text": "コンペトーのすぐちかくです！", "textZh": "就在康佩特附近！"},
  {"who": "ファ", "whoZh": "花", "text": "とりつかれました！」", "textZh": "已经贴上来了！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "なぜ　はっけんがおくれた！？", "textZh": "为什么这么晚才发现！？"},
  {"who": "ファ", "whoZh": "花", "text": "ミノフスキーりゅうしの　のうどが", "textZh": "米诺夫斯基粒子的浓度"},
  {"who": "ファ", "whoZh": "花", "text": "たかすぎて　レーダーが　まったく", "textZh": "太高，雷达完全"},
  {"who": "ファ", "whoZh": "花", "text": "やくにたちません！」", "textZh": "派不上用场！"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "てきさんも　やるじゃないの", "textZh": "敌人也挺有两下子嘛"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "ちょくせつ　こうげきを", "textZh": "居然直接"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "しかけてくるなんてさ」", "textZh": "攻过来"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "ジュドー！　のんきなことを", "textZh": "捷多！现在可不是"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "いっているばあいじゃないぞ　きみのＺＺは", "textZh": "说这种悠哉话的时候，你的ZZ"},
  {"who": "アムロ", "whoZh": "阿姆罗", "text": "せいびちゅうで　うごかせないんだ」", "textZh": "正在整备中，动不了"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "ちぇっ！！　またかよっ！", "textZh": "切！！又来啊！"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "おれのでばんは　おあずけってわけか！！」", "textZh": "我的出场又要押后了吗！！"},
  {"who": "デューク", "whoZh": "迪克", "text": "ぼくのグレンダイザーも", "textZh": "我的古连泰沙也"},
  {"who": "デューク", "whoZh": "迪克", "text": "いませいびちゅうで　うごかせない！！", "textZh": "现在正在整备中，动不了！！"},
  {"who": "デューク", "whoZh": "迪克", "text": "たのんだぞみんな！", "textZh": "拜托你们了，大家！"},
  {"who": "甲児", "whoZh": "甲儿", "text": "まかせてくれ　だいすけさん！！」", "textZh": "交给我吧，大介先生！！"},
  {"who": "ボス", "whoZh": "波士", "text": "ひさしぶりの", "textZh": "久违的"},
  {"who": "ボス", "whoZh": "波士", "text": "おれさまのでばんだわさ！！」", "textZh": "本大爷的出场时间到了！！"},
  {"who": "甲児", "whoZh": "甲儿", "text": "ボス！！　むちゃするんじゃないぞ！！", "textZh": "波士！！别乱来啊！！"},
  {"who": "甲児", "whoZh": "甲儿", "text": "ボロットの　せいのうじゃ　しょうめんから", "textZh": "就你那机器人的性能，从正面"},
  {"who": "甲児", "whoZh": "甲儿", "text": "たたかうのは　ふりだ！！」", "textZh": "作战太勉强了！！"},
  {"who": "ボス", "whoZh": "波士", "text": "だいじょうぶだって", "textZh": "没事啦"},
  {"who": "ボス", "whoZh": "波士", "text": "まかせてくれ　かぶと", "textZh": "交给我吧，甲儿"},
  {"who": "ボス", "whoZh": "波士", "text": "ボロットだって　パワーアップしたんだぜ」", "textZh": "我的机器人也强化过了"},
  {"who": "プル", "whoZh": "普露", "text": "あたしも　いくっ！」", "textZh": "我也要去！"},
  {"who": "ジュドー", "whoZh": "捷多", "text": "お　おい　プル！　よせ！」", "textZh": "喂、喂，普露！别去！"},
  {"who": "プル", "whoZh": "普露", "text": "だいじょうぶだよ！", "textZh": "没事啦！"},
  {"who": "プル", "whoZh": "普露", "text": "あたし　こうみえても　そうじゅう", "textZh": "别看我这样，驾驶技术"},
  {"who": "プル", "whoZh": "普露", "text": "うまいんだから！！」", "textZh": "可是很好的！！"},
  {"section": "【マップ】", "sectionZh": "【战场】"},
  {"section": "「５ターン目　ＥＰ」", "sectionZh": "「第5回合 敌方回合」"},
  {"who": "グレミー", "whoZh": "格雷米", "text": "きたか！", "textZh": "来了吗！"},
  {"who": "ラカン", "whoZh": "拉坎", "text": "グレミー！！　かせいにきたぞ！！」", "textZh": "格雷米！！增援来了！！"},
  {"who": "グレミー", "whoZh": "格雷米", "text": "ラカンか！　おんにきる！」", "textZh": "是拉坎吗！感激不尽！"},
  {"section": "「戦闘終了後」", "sectionZh": "「战斗结束后」"},
  {"who": "ファ", "whoZh": "花", "text": "ブライトかんちょう", "textZh": "布莱特舰长"},
  {"who": "ファ", "whoZh": "花", "text": "つうしんがはいっています」", "textZh": "有通讯进来"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "よう　ひさしぶりだな！", "textZh": "哟，好久不见！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "おうえんにきたぞ！」", "textZh": "来支援了！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "ヘンケンかんちょう！", "textZh": "亨肯舰长！"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "いつ　うちゅうに・・・」", "textZh": "您什么时候到宇宙来的……"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "きみたちのおかげで", "textZh": "多亏了你们"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ちきゅうけんの　たたかいも", "textZh": "地球圈的战斗"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ひとだんらく　ついてな", "textZh": "也告一段落了"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "こうして　おうえんにも", "textZh": "所以我才能这样"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "これたというわけさ」", "textZh": "前来支援"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "それにしても", "textZh": "话说回来"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "よく　このばしょがわかりましたね」", "textZh": "您是怎么知道这个地方的"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "かれのおかげさ」", "textZh": "多亏了他啊"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "かれ？」", "textZh": "他？"},
  {"who": "マサキ", "whoZh": "正树", "text": "よっ！！　もどってきたぜ", "textZh": "哟！！我回来了"},
  {"who": "マサキ", "whoZh": "正树", "text": "とちゅうで　へんなおっさんと　であったんで", "textZh": "路上遇到个奇怪的大叔"},
  {"who": "マサキ", "whoZh": "正树", "text": "ついでに　つれてきた」", "textZh": "就顺路带来了"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "マサキ！！」", "textZh": "正树！！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "おっさんは　よせって！", "textZh": "别叫大叔！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "オレは　まだ３０そこそこだぞ", "textZh": "我才三十出头啊"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "おう　そんなことより", "textZh": "哦，先不说这个"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "カミーユは　いるかね」", "textZh": "卡缪在吗"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "はい？　なんです？」", "textZh": "是？什么事？"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ふふふ　じつは　きみに", "textZh": "呵呵呵，其实我想"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "あわせたいひとが　いるんだ・・・", "textZh": "让你见一个人……"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "と！？　おい！　まだでちゃ　だめだって！", "textZh": "咦！？喂！说了还不能出来！"},
  {"who": "フォウ", "whoZh": "凤", "text": "カミーユ！！」", "textZh": "卡缪！！"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "フォウ！？", "textZh": "凤！？"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "ほんとうに　フォウなのか！？", "textZh": "真的是凤吗！？"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "・・・ぶじだったのか！！」", "textZh": "……你平安无事啊！！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "おいおい　せっかくかんどうてきなさ", "textZh": "喂喂，我好不容易"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "いかいシーンに　してやろうとおもってたのにこ", "textZh": "想给你们安排个感人场面"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "れじゃ　さんもんしばいだ・・・」", "textZh": "这下成了三流闹剧了……"},
  {"who": "フォウ", "whoZh": "凤", "text": "カミーユ　けがしてない？", "textZh": "卡缪，没受伤吧？"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "ああ　フォウ　きみこそ", "textZh": "啊，凤，你才是"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "よくぶじで・・・」", "textZh": "能平安无事真是太好了……"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "・・・まあ　やすっぽい", "textZh": "……嘛，偶尔来点"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "メロドラマなんてのも　たまにはいいか", "textZh": "廉价的感情戏也不错"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "フン・・・　ヤボだったな", "textZh": "哼……是我扫兴了"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "カミーユ　せっかくのところ", "textZh": "卡缪，不好意思"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "じゃまして　わるいんだが　しばらくフォウは", "textZh": "打扰你们，不过凤暂时"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "わたしたちのところで　あずかるぞ", "textZh": "先由我们照看"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "わたしのぶたいも　きびしくてな", "textZh": "我的部队也很吃紧"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "フォウは　きちょうなせんりょくなんだ", "textZh": "凤是宝贵的战力"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "この　たたかいがおわったら", "textZh": "等这场战斗结束"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "すきなだけ　ふたりでいられるんだから", "textZh": "你们俩想待多久都行"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "しばらくは　かりててもいいだろう？」", "textZh": "所以暂时借用一下，可以吧？"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "え・・・ええ」", "textZh": "嗯……嗯"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ハハハハ　そうしんぱいそうな", "textZh": "哈哈哈，别摆出"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "かおを　するなって", "textZh": "那么担心的表情"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "こいびとが　しんぱいなのは　わかるがな」", "textZh": "我懂你担心恋人"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "い　いや　べつに　フォウは", "textZh": "不、不是，凤她"},
  {"who": "カミーユ", "whoZh": "卡缪", "text": "こいびとってわけじゃ・・・」", "textZh": "并不是什么恋人……"},
  {"who": "ファ", "whoZh": "花", "text": "ヘンケンかんちょう！！", "textZh": "亨肯舰长！！"},
  {"who": "ファ", "whoZh": "花", "text": "さくせんかいぎは　どうされるんですか！！", "textZh": "作战会议要怎么办！！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "わっ！　ファか", "textZh": "哇！是花啊"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "おどろかすなよ・・・　？　なにを", "textZh": "别吓我啊……？你"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "そんなに　おこってるんだ？", "textZh": "怎么气成这样？"},
  {"who": "ファ", "whoZh": "花", "text": "おこってなんか　いません！！」", "textZh": "我才没生气！！"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "・・・・」", "textZh": "……"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "ま　まあ　とにかく", "textZh": "好、好了，总之"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "つぎの　さくせんを　かんがえよう", "textZh": "来考虑下一步作战吧"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "ヘンケンかんちょう", "textZh": "亨肯舰长"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "Ｄ・Ｃの　グラナダきちの　こうりゃくは", "textZh": "攻打D·C的格拉纳达基地"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "どういったルートが　こうかてきでしょう？」", "textZh": "走哪条路线比较有效？"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "う　うむ", "textZh": "嗯、嗯"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "じょうほうによると　きたがわのルートが", "textZh": "根据情报，北侧的路线"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ひかくてき　てうすのようだ", "textZh": "兵力相对薄弱"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "われわれが　みなみから", "textZh": "我们从南边"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "ようどうにでるから　そのすきに", "textZh": "佯攻吸引，你们趁这机会"},
  {"who": "ヘンケン", "whoZh": "亨肯", "text": "きたのルートを　こうりゃくしてくれ」", "textZh": "攻打北边的路线"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "わかりました", "textZh": "明白了"},
  {"who": "ブライト", "whoZh": "布莱特", "text": "みんな　いくぞ」", "textZh": "大家，上"}
 ]
}
