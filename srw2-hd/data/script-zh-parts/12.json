   "who": "マサキ",
   "whoZh": "正树",
   "text": "きしゅうには　もってこいだ」",
   "textZh": "正是奇袭的好时机」"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "・・・たしかに　あいての",
   "textZh": "……确实，抓住对方"
