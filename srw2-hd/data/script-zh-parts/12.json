{
 "title": "第１２話　「ラサの攻防」",
 "titleZh": "第12话「拉萨攻防」",
 "lines": [
  {
   "section": "【インターミッション】",
   "sectionZh": "【幕间】"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "なるほど　はなしはわかった",
   "textZh": "原来如此，情况我明白了"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "だが　いま　やつらのほんきょちに",
   "textZh": "但是现在，闯进他们的本根据地"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "しんにゅうして　かちめがあるのか？」",
   "textZh": "能有胜算吗？」"
  },
  {
   "who": "マサキ",
   "whoZh": "正树",
   "text": "チッチッ　わかってねぇな",
   "textZh": "啧啧，你们不懂啊"
