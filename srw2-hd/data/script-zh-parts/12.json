  {
   "who": "甲児",
   "whoZh": "甲儿",
   "text": "かんづかれちまう！　いこうぜ！」",
   "textZh": "察觉的！走吧！」"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "すまない　たのんだぞ」",
   "textZh": "抱歉，拜托你们了」"
