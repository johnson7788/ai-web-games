  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "そくどがおちているぞ！」",
   "textZh": "速度在下降啊！」"
  },
  {
   "who": "ファ",
   "whoZh": "花",
   "text": "だめです！",
   "textZh": "不行了！"
  },
  {
   "who": "ファ",
   "whoZh": "花",
   "text": "エンジン８０％しゅつりょくていか！",
   "textZh": "引擎输出下降到80%！"
  },
  {
   "who": "ファ",
   "whoZh": "花",
   "text": "げんいんふめいです！",
   "textZh": "原因不明！"
  },
  {
   "who": "ファ",
   "whoZh": "花",
   "text": "ミノフスキークラフトにも",
   "textZh": "米诺夫斯基飞行器也"
