  {
   "who": "ファ",
   "whoZh": "花",
   "text": "いじょうはっせい！",
   "textZh": "出现异常！"
  },
  {
   "who": "ファ",
   "whoZh": "花",
   "text": "・・・こうこうふのうです！」",
   "textZh": "……无法航行！」"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "なんてことだ・・・　」",
   "textZh": "怎么会这样……　」"
  },
  {
   "who": "ボス",
   "whoZh": "波士",
   "text": "ま　こわれちまったもんは",
   "textZh": "嘛，坏了的东西"
