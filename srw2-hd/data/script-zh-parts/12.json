  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "すきを　つくことは　じゅうようだが・・・」",
   "textZh": "破绽很重要，但是……」"
  },
  {
   "who": "マサキ",
   "whoZh": "正树",
   "text": "ちっ　にえきらねぇな",
   "textZh": "啧，真不痛快"
  },
  {
   "who": "マサキ",
   "whoZh": "正树",
   "text": "なら　オレひとりで　やるぜ！！」",
   "textZh": "那我自己去干！！」"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "・・・わかった",
   "textZh": "……明白了"
  },
  {
   "who": "ブライト",
   "whoZh": "布莱特",
   "text": "ラサを　きょうしゅうする！",
   "textZh": "强袭拉萨！"
  },
