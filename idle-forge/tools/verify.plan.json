{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().level === 1", "name": "第 1 关" },
    { "assert": "window.__ll.debug.layout().anvil.x > 0", "name": "铁砧布局存在" },
    { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.debug.startSeeded(0, 3)" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.autoForge(3)" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().level >= 3", "name": "greedy 推进到第 3 关" },
    { "assert": "window.__ll.debug.state().coins > 0", "name": "已产金币" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "终章结算" },
    { "screenshot": "03-result.png" },
    { "eval": "window.__ll.debug.loadLevel(2)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().mechanic === 'shortage'", "name": "L3 材料短缺" },
    { "screenshot": "04-shortage.png" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().mechanic === 'furnace'", "name": "L5 炉候窗口" },
    { "screenshot": "05-furnace.png" },
    { "eval": "window.__ll.debug.loadLevel(5)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().mechanic === 'vein'", "name": "L6 稀有矿脉" },
    { "screenshot": "06-vein.png" },
    { "eval": "window.__ll.debug.loadLevel(6)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().scene === 'volcano'", "name": "L7 火山场景" },
    { "screenshot": "07-volcano.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.setTutorialDone(true); window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 800 },
      { "screenshot": "m-title.png" },
      { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start(0)" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "m-playing.png" }
    ]
  }
}
