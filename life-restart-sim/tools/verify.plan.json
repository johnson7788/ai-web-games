{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('btn-start').textContent.length > 0", "name": "开始按钮有文案" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'talent'", "name": "进入选天赋" },
    { "screenshot": "02-talents.png" },
    { "assert": "document.querySelectorAll('.talent-card').length === 10", "name": "天赋候选 10 个" },
    { "eval": "window.__ll.debug.pickBestTalents()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'allocate'", "name": "进入分配点数" },
    { "screenshot": "03-allocate.png" },
    { "eval": "window.__ll.debug.autoAllocate()" },
    { "eval": "window.__ll.debug.startLife()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'life'", "name": "进入人生" },
    { "eval": "window.__ll.debug.advanceTo(3)" },
    { "wait": 300 },
    { "screenshot": "04-life.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'life'", "name": "恢复" },
    { "eval": "window.__ll.debug.advanceTo(6)" },
    { "wait": 300 },
    { "assert": "window.__ll.run.state.pendingChoice !== null", "name": "命运抉择出现" },
    { "screenshot": "05-choice.png" },
    { "eval": "window.__ll.debug.resolveChoice('a')" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.fastLife()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'summary'", "name": "人生结算" },
    { "screenshot": "06-summary.png" },
    { "assert": "window.__ll.run.state.stars >= 0 && window.__ll.run.state.summary.score > 0", "name": "结算有星级与总分" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 300 },
    { "screenshot": "07-summary-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 300 },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start()" },
      { "wait": 300 },
      { "eval": "window.__ll.debug.pickBestTalents()" },
      { "eval": "window.__ll.debug.autoAllocate()" },
      { "eval": "window.__ll.debug.startLife()" },
      { "wait": 300 },
      { "eval": "window.__ll.debug.advanceTo(6)" },
      { "wait": 300 },
      { "screenshot": "08-mobile.png" },
      { "assert": "window.__ll.run.state.pendingChoice !== null", "name": "移动端命运抉择" }
    ]
  }
}
