{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 12", "name": "关卡格 12 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "screenshot": "03-playing.png" },
    { "assert": "window.__ll.debug.state().tiles.length > 0", "name": "宝库堆有块" },
    { "assert": "window.__ll.debug.state().tray.length === 0", "name": "槽初始为空" },
    { "eval": "window.__ll.debug.autoPlaceSolution()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "清空到结算" },
    { "screenshot": "04-result.png" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "通关至少 1 星" },
    { "eval": "window.__ll.debug.loadLevel(3)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().tiles.length > 0", "name": "L4 深井层有块" },
    { "screenshot": "05-deepwell.png" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().scene === 'tomb'", "name": "L5 古墓场景" },
    { "screenshot": "06-dual-tomb.png" },
    { "eval": "window.__ll.debug.loadLevel(8)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().scene === 'dragon'", "name": "L9 龙巢场景" },
    { "screenshot": "07-dragon.png" },
    { "eval": "window.__ll.debug.loadLevel(11)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().tiles.length > 0", "name": "L12 龙巢宝山有块" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "m-title.png" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进游戏" },
      { "screenshot": "m-playing.png" }
    ]
  }
}
