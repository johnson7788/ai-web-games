{
  "viewport": [1280, 720],
  "steps": [
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 波" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().wave === 1 && window.__ll.debug.state().phase === 'wave'", "name": "第 1 波进行中" },
    { "eval": "window.__ll.debug.startSeeded(0, 3)" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.autoPlaceSolution()" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().kills > 0 || window.__ll.debug.state().phase === 'upgrade' || window.__ll.debug.state().phase === 'won'", "name": "有击杀或已清波" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.sim() && (window.__ll.sim().phase !== 'wave' || window.__ll.sim().wave >= 2 || window.__ll.sim().kills > 0)", "name": "已推进到第 2 波或更后" },
    { "screenshot": "03-result.png" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().sandstorm === true", "name": "L5 沙暴" },
    { "screenshot": "04-sandstorm.png" },
    { "eval": "window.__ll.debug.loadLevel(8)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().night === true", "name": "L9 夜袭" },
    { "screenshot": "05-night.png" },
    { "eval": "window.__ll.debug.loadLevel(7)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().enemies.some(e=>e.kind==='boss')", "name": "L8 Boss 在场" },
    { "screenshot": "06-boss.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "wait": 500 },
      { "eval": "window.__ll.start(0)" },
      { "wait": 600 },
      { "screenshot": "07-mobile-playing.png" },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入战斗" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.setTutorialDone(true);window.__ll.debug.startSeeded(0,3);",
    "prepareWait": 400
  }
}
