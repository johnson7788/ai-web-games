{
  "viewport": [
    1280,
    720
  ],
  "steps": [
    {
      "wait": 900
    },
    {
      "assert": "window.__ll.state.phase === 'title'",
      "name": "标题屏"
    },
    {
      "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'",
      "name": "默认英文/LTR"
    },
    {
      "assert": "window.__ll.state.lang === 'en'",
      "name": "i18n 默认 en"
    },
    {
      "eval": "(()=>{localStorage.clear(); return true;})()"
    },
    {
      "eval": "window.location.reload()"
    },
    {
      "wait": 1200
    },
    {
      "screenshot": "v01-title.png"
    },
    {
      "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"
    },
    {
      "wait": 250
    },
    {
      "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'",
      "name": "切中文生效"
    },
    {
      "screenshot": "v02-title-zh.png"
    },
    {
      "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()"
    },
    {
      "wait": 250
    },
    {
      "assert": "document.documentElement.lang === 'en'",
      "name": "切回英文"
    },
    {
      "click": "#btn-start"
    },
    {
      "wait": 700
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "开局进入 playing"
    },
    {
      "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')",
      "name": "首次进入引导出现"
    },
    {
      "screenshot": "v03-tutorial.png"
    },
    {
      "click": "[data-tutorial-skip]"
    },
    {
      "wait": 400
    },
    {
      "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')",
      "name": "跳过引导后消失"
    },
    {
      "wait": 1500
    },
    {
      "eval": "window.__ll.run.time > 0.5"
    },
    {
      "assert": "window.__ll.run.time > 0.5",
      "name": "自动弹跳推进（游戏时间推进）"
    },
    {
      "screenshot": "v04-play.png"
    },
    {
      "press": "Escape"
    },
    {
      "wait": 400
    },
    {
      "assert": "window.__ll.state.phase === 'paused'",
      "name": "暂停"
    },
    {
      "screenshot": "v05-paused.png"
    },
    {
      "press": "Escape"
    },
    {
      "wait": 300
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "恢复"
    },
    {
      "eval": "window.__ll.debug.forceDie()"
    },
    {
      "wait": 500
    },
    {
      "assert": "window.__ll.state.phase === 'dead'",
      "name": "死亡流程"
    },
    {
      "assert": "!document.querySelector('#screen-result').classList.contains('hidden')",
      "name": "结算卡出现"
    },
    {
      "screenshot": "v06-dead.png"
    },
    {
      "press": "KeyR"
    },
    {
      "wait": 600
    },
    {
      "assert": "window.__ll.state.phase === 'playing'",
      "name": "R 键一键重玩"
    },
    {
      "assert": "(()=>{const v=window.PipyGames; return !v || typeof v.track==='function' || true;})()",
      "name": "SDK 存在或降级不崩"
    },
    {
      "screenshot": "v07-restart.png"
    }
  ],
  "mobile": {
    "viewport": [
      844,
      390
    ],
    "steps": [
      {
        "wait": 900
      },
      {
        "assert": "window.__ll.state.phase === 'title'",
        "name": "移动端标题屏"
      },
      {
        "click": "#btn-start"
      },
      {
        "wait": 800
      },
      {
        "assert": "window.__ll.state.phase === 'playing'",
        "name": "移动端开局"
      },
      {
        "wait": 1500
      },
      {
        "assert": "window.__ll.run.time > 0.5",
        "name": "移动端推进"
      },
      {
        "screenshot": "v08-mobile-play.png"
      }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start()"
  }
}