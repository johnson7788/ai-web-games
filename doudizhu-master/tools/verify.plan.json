{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 700 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 200 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入牌局" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.run().state.players[0].hand.length === 20", "name": "地主 20 张" },
    { "assert": "window.__ll.run().state.players[1].hand.length === 17 && window.__ll.run().state.players[2].hand.length === 17", "name": "两农民各 17 张" },
    { "eval": "window.__ll.run().hint()" },
    { "wait": 200 },
    { "assert": "window.__ll.run().state.selected.size > 0", "name": "提示选中可出牌" },
    { "eval": "window.__ll.run().playSelected()" },
    { "wait": 300 },
    { "assert": "window.__ll.run().state.players[0].hand.length < 20", "name": "已出牌" },
    { "screenshot": "03-played.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本局" },
    { "assert": "window.__ll.run().state.players[0].hand.length === 20", "name": "重开后地主 20 张" },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "04-result.png" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  },
  "mobile": {
    "viewport": [390, 844],
    "steps": [
      { "wait": 600 },
      { "assertVisible": "#rotate-screen", "name": "竖屏显示旋转提示" },
      { "eval": "document.getElementById('btn-rotate-skip').click()" },
      { "wait": 200 },
      { "assert": "document.getElementById('rotate-screen').style.display === 'none'", "name": "skip 关闭旋转遮罩" }
    ]
  }
}
