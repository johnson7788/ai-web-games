{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "wait": 200 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 12", "name": "周格 12 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 周" },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().week === 1", "name": "第 1 周" },
    { "assert": "window.__ll.debug.state().slotsPerWeek === 5", "name": "5 个课时" },
    { "assert": "window.__ll.debug.state().attrs.grades === 30", "name": "初始成绩" },
    { "eval": "window.__ll.run().assign('study')" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().slots.length === 1", "name": "已排 1 节课" },
    { "eval": "window.__ll.debug.startSeeded(0, 3)" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.autoAssign()" },
    { "wait": 300 },
    { "assert": "window.__ll.debug.state().slots.length >= 4", "name": "自动排课" },
    { "eval": "window.__ll.run().endWeek()" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "学期末结算" },
    { "screenshot": "03-result.png" },
    { "assert": "window.__ll.debug.state().phase === 'won' || window.__ll.debug.state().phase === 'lost'", "name": "sim 终局" },
    { "eval": "window.__ll.debug.loadLevel(4)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().week === 5", "name": "第 5 周夏夜萤院" },
    { "screenshot": "04-summer.png" },
    { "eval": "window.__ll.debug.loadLevel(8)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().week === 9", "name": "第 9 周冬雪书馆" },
    { "screenshot": "05-winter.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本局" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 700 },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 600 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "06-mobile.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.start(0)"
  }
}
