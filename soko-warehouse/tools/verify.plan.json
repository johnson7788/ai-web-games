{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 700 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('level-grid').children.length === 12", "name": "关卡格 12 个" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "08-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true)" },
    { "eval": "window.__ll.start(0)" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入第 1 关" },
    { "assert": "window.__ll.debug.state().rows === 5 && window.__ll.debug.state().boxes === 1", "name": "L1 5 行 1 箱" },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.solve()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "通关结算" },
    { "assert": "window.__ll.debug.state().stars >= 1", "name": "至少 1 星" },
    { "screenshot": "03-result.png" },
    { "eval": "window.__ll.debug.loadLevel(1)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().rocks > 0", "name": "L2 有岩石" },
    { "screenshot": "04-rock.png" },
    { "eval": "window.__ll.debug.loadLevel(5)" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().boxes === 3", "name": "L6 三箱" },
    { "screenshot": "05-combo.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开本关" },
    { "screenshot": "07-undo.png" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(0)" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 700 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "eval": "window.__ll.debug.setTutorialDone(true)" },
      { "eval": "window.__ll.start(0)" },
      { "wait": 500 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "eval": "window.__ll.debug.move('right')" },
      { "wait": 250 },
      { "assert": "window.__ll.debug.state().moves >= 1", "name": "移动生效" },
      { "eval": "window.__ll.debug.move('down')" },
      { "wait": 200 },
      { "assert": "window.__ll.debug.state().moves >= 2", "name": "连续移动生效" }
    ]
  }
}
