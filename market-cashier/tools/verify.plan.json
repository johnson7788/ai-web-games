{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.getElementById('title-text').textContent.includes('超市')", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "assert": "window.__ll.debug.state().phase === 'scan'", "name": "扫码阶段" },
    { "assert": "window.__ll.debug.state().items.length >= 3", "name": "顾客有商品" },
    { "assert": "window.__ll.debug.state().target >= 600", "name": "每日目标存在" },
    { "screenshot": "02-scan.png" },
    { "eval": "window.__ll.debug.scanAll()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().phase === 'change'", "name": "进入找零阶段" },
    { "screenshot": "03-change.png" },
    { "eval": "window.__ll.debug.serveCorrect()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().served >= 1", "name": "完成一单" },
    { "assert": "window.__ll.debug.state().score > 0", "name": "得分增加" },
    { "assert": "window.__ll.debug.state().combo >= 1", "name": "连击生效" },
    { "eval": "window.__ll.debug.scanAll()" },
    { "eval": "window.__ll.debug.addMoney(1)" },
    { "eval": "window.__ll.debug.give()" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().served === 1", "name": "错误找零不成交" },
    { "assert": "window.__ll.debug.state().combo === 0", "name": "错误找零断连击" },
    { "eval": "(()=>{for(let i=0;i<4;i++){const st=window.__ll.debug.state(); if(st.phase!=='scan'&&st.phase!=='change') break; window.__ll.debug.serveCorrect();} return window.__ll.debug.state().phase;})()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'day'", "name": "一天结束进入班次结算" },
    { "assert": "document.querySelectorAll('.upgrade-card').length === 3", "name": "三选一升级卡" },
    { "screenshot": "04-day-clear.png" },
    { "eval": "document.querySelector('.upgrade-card').click()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "选择升级后继续" },
    { "assert": "window.__ll.debug.state().day === 2", "name": "进入第 2 天" },
    { "screenshot": "05-day2.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "重启回标题" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
