{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{const r=window.__ll.run; r.step({aimX:640,aimY:200,fire:true}); r.step({aimX:640,aimY:200,fire:false}); return true;})()" },
    { "wait": 300 },
    { "assert": "window.__ll.run.ammo < window.__ll.run.maxAmmo", "name": "开火消耗弹量" },
    { "assert": "window.__ll.run.shotsUsed === 1", "name": "已发射 1 发" },
    { "wait": 1600 },
    { "assert": "window.__ll.run.enemies.length > 0 || window.__ll.run.level > 1", "name": "战斗推进" },
    { "screenshot": "03-play.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 350 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "04-paused.png" },
    { "eval": "window.__ll.resume()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<60*400&&r.phase==='playing';k++){r.step({}); r.drainEvents();} return r.phase;})()" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "熔毁/弹尽死亡" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "05-dead.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键一键重开" },
    { "assert": "(()=>{const v=window.PipyGames; return !v || typeof v.track==='function';})()", "name": "SDK 存在或降级不崩" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 500 },
      { "eval": "(()=>{const r=window.__ll.run; r.step({aimX:420,aimY:180,fire:true}); r.step({aimX:420,aimY:180,fire:false}); return true;})()" },
      { "wait": 1600 },
      { "assert": "window.__ll.run.level >= 1 && window.__ll.run.enemies.length >= 0", "name": "移动端运行推进" },
      { "screenshot": "06-mobile-play.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" }
}
