{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 400 },
    { "eval": "window.__ll.debug.skipTutorial()" },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "eval": "window.__ll.debug.buy(); window.__ll.debug.buy(); true" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.state().tabs[0].slots[0].doll === 1", "name": "购买生成 1 级玩偶" },
    { "screenshot": "03-playing.png" },
    { "eval": "window.__ll.debug.merge(0, 1)" },
    { "wait": 250 },
    { "assert": "window.__ll.debug.maxLevel() === 2", "name": "合成升到 2 级" },
    { "screenshot": "04-merged.png" },
    { "eval": "(()=>{const s=window.__ll.run.state.tabs[0].slots; s[2].doll=2; s[3].doll=2; return true;})()" },
    { "eval": "window.__ll.debug.merge(2, 3)" },
    { "wait": 250 },
    { "assert": "window.__ll.run.state.stage >= 2", "name": "到 3 级通关阶段 1" },
    { "eval": "(()=>{const s=window.__ll.run.state.tabs[0].slots; const arr=[1,1,2,2,3,3,4,5,6,7]; arr.forEach((lv,i)=>{s[i].doll=lv;}); s[10].rock=true; return true;})()" },
    { "wait": 300 },
    { "screenshot": "05-board.png" },
    { "eval": "window.__ll.debug.tapRock(10)" },
    { "wait": 200 },
    { "screenshot": "06-stage.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "重开回标题" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": false },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" },
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题" },
      { "eval": "window.__ll.start()" },
      { "wait": 400 },
      { "eval": "window.__ll.debug.skipTutorial()" },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "eval": "window.__ll.debug.buy()" },
      { "wait": 250 },
      { "screenshot": "07-mobile.png" }
    ]
  }
}
