{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "wait": 400 },
    { "screenshot": "01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文生效" },
    { "screenshot": "06-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次引导出现" },
    { "screenshot": "02-play.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<40;k++) r.step({launch:true}); r.step({launch:false}); return r.balls.some(b=>b.state==='live');})()" },
    { "wait": 400 },
    { "assert": "window.__ll.run.balls.some(b=>b.state==='live')", "name": "发射后球在台上" },
    { "eval": "(()=>{const r=window.__ll.run; r.superconductT=8; r.superconducts.forEach(s=>s.lit=true); return true;})()" },
    { "wait": 250 },
    { "screenshot": "03-superconduct.png" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "04-paused.png" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<60*90 && r.phase!=='dead'; k++){ r.step({left:false,right:false,launch:false,nudge:0}); r.drainEvents(); } return r.phase;})()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'dead'", "name": "掉球判负" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "07-dead.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键重开" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "wait": 1200 },
      { "screenshot": "05-mobile.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  }
}
