{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文生效" },
    { "screenshot": "09-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "screenshot": "01-title.png" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "eval": "(()=>{const r=window.__ll.run; const x0=r.player.x; for(let i=0;i<90;i++){r.step({right:true}); r.drainEvents();} return r.player.x;})()" },
    { "assert": "window.__ll.run.player.x > 200", "name": "向右跑动推进" },
    { "eval": "(()=>{const r=window.__ll.run; for(let i=0;i<60;i++){r.step({jumpHeld:true}); r.drainEvents();} return true;})()" },
    { "assert": "window.__ll.run.player.y < 700", "name": "跳跃动作有效" },
    { "eval": "window.__ll.debug.startLevel(1); window.__ll.debug.placePlayer(100*45-250);" },
    { "wait": 300 },
    { "screenshot": "02-play.png" },
    { "eval": "window.__ll.debug.startLevel(2); window.__ll.debug.placePlayer(110*45-250);" },
    { "wait": 300 },
    { "screenshot": "03-play2.png" },
    { "eval": "window.__ll.debug.startLevel(5); window.__ll.debug.placePlayer(132*45-250);" },
    { "wait": 300 },
    { "screenshot": "04-sewer.png" },
    { "eval": "window.__ll.debug.startLevel(7); window.__ll.debug.placePlayer(142*45-250);" },
    { "wait": 300 },
    { "screenshot": "05-dark.png" },
    { "eval": "window.__ll.debug.startLevel(9); window.__ll.debug.placePlayer(142*45-250);" },
    { "wait": 300 },
    { "screenshot": "06-factory.png" },
    { "eval": "window.__ll.debug.startLevel(12); window.__ll.debug.placePlayer(162*45-250);" },
    { "wait": 300 },
    { "screenshot": "07-finale.png" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "重启回标题" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "assert": "!document.getElementById('touch-bar').classList.contains('hidden')", "name": "触屏控制条可见" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "click": "[data-tutorial-skip]" },
      { "wait": 400 },
      { "eval": "window.__ll.debug.startLevel(1); window.__ll.debug.placePlayer(100*45-250);" },
      { "wait": 300 },
      { "screenshot": "08-mobile-play.png" }
    ]
  },
  "checks": { "console": true, "failedRequests": true, "external": false }
}
