{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 900 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{localStorage.clear(); return true;})()" },
    { "eval": "window.location.reload()" },
    { "wait": 1200 },
    { "screenshot": "v01-title.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh' && document.documentElement.dir === 'ltr'", "name": "切中文生效" },
    { "screenshot": "v02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "click": "#btn-start" },
    { "wait": 700 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "开局进入 playing" },
    { "assert": "!!document.querySelector('[data-tutorial]') && !document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "首次进入引导出现" },
    { "screenshot": "v03-tutorial.png" },
    { "click": "[data-tutorial-skip]" },
    { "wait": 400 },
    { "assert": "document.querySelector('[data-tutorial]').classList.contains('hidden')", "name": "跳过引导后消失" },
    { "wait": 800 },
    { "assert": "window.__ll.run.question !== null", "name": "第一题已出" },
    { "click": "#opt-0" },
    { "wait": 500 },
    { "assert": "window.__ll.run.combo >= 0 && window.__ll.run.time > 0", "name": "真实点击选项生效" },
    { "screenshot": "v04-play.png" },
    { "press": "Escape" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "screenshot": "v05-paused.png" },
    { "press": "Escape" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "(()=>{const r=window.__ll.run; for(let k=0;k<60*500&&r.phase==='playing';k++){r.step({choose: r.question?r.question.answerIndex:null}); r.drainEvents();} return r.phase;})()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'finished'", "name": "跑完 12 赛进入结算" },
    { "assert": "!document.querySelector('#screen-result').classList.contains('hidden')", "name": "结算卡出现" },
    { "screenshot": "v06-result.png" },
    { "press": "KeyR" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "R 键再赛一局" },
    { "assert": "(()=>{const v=window.PipyGames; return !v || typeof v.track==='function' || true;})()", "name": "SDK 存在或降级不崩" },
    { "screenshot": "v07-restart.png" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 900 },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "click": "#btn-start" },
      { "wait": 800 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端开局" },
      { "assert": "window.__ll.run.question !== null", "name": "移动端出题" },
      { "wait": 800 },
      { "screenshot": "v08-mobile-play.png" }
    ]
  },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start()" },
  "checks": { "console": true, "failedRequests": true, "external": false }
}
