{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "document.getElementById('btn-start') && document.getElementById('btn-howto')", "name": "标题有开始与引导入口" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "eval": "if (window.__ll.tutorial.active) window.__ll.tutorial.skip()" },
    { "wait": 300 },
    { "screenshot": "02-playing.png" },
    { "assert": "window.__ll.debug.state().level === 1", "name": "第 1 级开局" },
    { "eval": "window.__ll.debug.act('feed'); window.__ll.debug.act('wash'); window.__ll.debug.act('play')" },
    { "wait": 500 },
    { "screenshot": "03-caring.png" },
    { "eval": "const st=window.__ll.debug.state(); st.wish='play'; st.mood=30; window.__ll.debug.act('play'); st.wish='play'; st.mood=30; window.__ll.debug.act('play'); st.wish='play'; st.mood=30; window.__ll.debug.act('play')" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().combo >= 3", "name": "连击累积" },
    { "screenshot": "04-combo.png" },
    { "eval": "window.__ll.debug.grantXp(40)" },
    { "wait": 500 },
    { "assert": "window.__ll.debug.state().level >= 2", "name": "升级到 2 级" },
    { "screenshot": "05-levelup.png" },
    { "eval": "window.__ll.debug.setStat('gold', 30)" },
    { "eval": "document.getElementById('btn-shop').click()" },
    { "wait": 300 },
    { "screenshot": "06-shop.png" },
    { "assert": "document.getElementById('shop-panel') && !document.getElementById('shop-panel').classList.contains('hidden')", "name": "商店打开" },
    { "eval": "document.getElementById('btn-shop-close').click()" },
    { "wait": 200 },
    { "eval": "window.__ll.debug.buy('toy')" },
    { "wait": 300 },
    { "eval": "window.__ll.debug.win()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算屏" },
    { "screenshot": "07-result.png" },
    { "assert": "window.__ll.debug.state().stars >= 1 && window.__ll.debug.state().stars <= 3", "name": "1~3 星" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回标题" },
    { "eval": "window.__ll.start()" },
    { "wait": 400 },
    { "eval": "if (window.__ll.tutorial.active) window.__ll.tutorial.skip()" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "checks": { "console": true, "failedRequests": true, "external": true },
  "fps": { "enabled": true, "min": 50, "prepare": "window.__ll.start(); if(window.__ll.tutorial.active){window.__ll.tutorial.skip();}" },
  "mobile": {
    "viewport": [390, 844],
    "steps": [
      { "wait": 800 },
      { "assert": "document.getElementById('rotate-screen') && getComputedStyle(document.getElementById('rotate-screen')).display !== 'none'", "name": "竖屏提示可见" },
      { "click": "#btn-rotate-skip" },
      { "wait": 300 },
      { "assert": "document.getElementById('rotate-screen').style.display === 'none'", "name": "跳过竖屏提示" }
    ]
  }
}
