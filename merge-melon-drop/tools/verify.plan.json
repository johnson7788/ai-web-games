{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 700 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "assert": "window.__ll.state.lang === 'en'", "name": "i18n 默认 en" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "01b-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "eval": "window.__ll.debug.dropAt(300)" },
    { "wait": 900 },
    { "screenshot": "02-playing.png" },
    { "eval": "window.__ll.debug.dropAt(300)" },
    { "wait": 900 },
    { "assert": "window.__ll.debug.state().merges >= 1", "name": "已合成一次" },
    { "screenshot": "03-merge.png" },
    { "eval": "window.__ll.debug.loadBoard('rock')" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().rockCount >= 1", "name": "盘面有岩石" },
    { "screenshot": "04-rock.png" },
    { "eval": "window.__ll.debug.loadBoard('merge')" },
    { "wait": 400 },
    { "assert": "window.__ll.debug.state().bodyCount >= 4", "name": "盘面有多个水果" },
    { "screenshot": "05-board.png" },
    { "eval": "window.__ll.debug.loadBoard('full'); window.__ll.debug.gameOver()" },
    { "wait": 500 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "结算" },
    { "assert": "window.__ll.debug.state().stars >= 2", "name": "结算至少 2 星" },
    { "screenshot": "06-result.png" },
    { "eval": "window.__ll.restart()" },
    { "wait": 300 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "重开" },
    { "eval": "window.__ll.debug.loadBoard('merge')" },
    { "wait": 400 },
    { "screenshot": "07-restart.png" },
    { "eval": "window.__ll.pause()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "m-title.png" },
      { "eval": "window.__ll.debug.setTutorialDone(true); window.__ll.start()" },
      { "wait": 500 },
      { "screenshot": "m-playing.png" },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": false
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.setTutorialDone(true); window.__ll.start()"
  }
}
