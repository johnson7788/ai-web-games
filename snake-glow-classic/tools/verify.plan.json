{
  "viewport": [1280, 720],
  "steps": [
    { "wait": 800 },
    { "screenshot": "01-title.png" },
    { "assert": "window.__ll.state.phase === 'title'", "name": "标题屏" },
    { "assert": "document.documentElement.lang === 'en' && document.documentElement.dir === 'ltr'", "name": "默认英文/LTR" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='zh'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'zh'", "name": "切中文" },
    { "screenshot": "02-title-zh.png" },
    { "eval": "(()=>{const s=document.getElementById('lang-select'); s.value='en'; s.dispatchEvent(new Event('change',{bubbles:true})); return true;})()" },
    { "wait": 250 },
    { "assert": "document.documentElement.lang === 'en'", "name": "切回英文" },
    { "eval": "window.__ll.start()" },
    { "wait": 600 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "进入游戏" },
    { "assert": "window.__ll.tutorial.active === true && window.__ll.tutorial.steps.length >= 3", "name": "首次进入出现交互引导" },
    { "click": "#tut-skip" },
    { "wait": 400 },
    { "assert": "window.__ll.tutorial.active === false", "name": "跳过引导" },
    { "eval": "window.__ll.debug.startSeeded(42)" },
    { "wait": 250 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "种子局进行中" },
    { "assert": "window.__ll.debug.state().snake.length >= 4 && window.__ll.debug.state().food !== null", "name": "蛇与食物存在" },
    { "screenshot": "03-playing.png" },
    { "eval": "window.__ll.debug.jump(45)" },
    { "wait": 150 },
    { "assert": "window.__ll.debug.state().stage >= 2 && window.__ll.debug.state().rocks.length > 0", "name": "第2段出现岩石" },
    { "screenshot": "04-rocks.png" },
    { "eval": "window.__ll.debug.startSeeded(7)" },
    { "wait": 120 },
    { "eval": "window.__ll.debug.fastForward()" },
    { "wait": 150 },
    { "assert": "window.__ll.state.phase === 'result'", "name": "贪心通关到结算" },
    { "screenshot": "05-result-win.png" },
    { "eval": "window.__ll.debug.startSeeded(9)" },
    { "wait": 120 },
    { "eval": "window.__ll.debug.forceWin()" },
    { "wait": 150 },
    { "assert": "document.getElementById('result-stars').textContent.includes('★★★')", "name": "胜利三星" },
    { "screenshot": "06-result-stars.png" },
    { "eval": "window.__ll.debug.startSeeded(11)" },
    { "wait": 120 },
    { "eval": "window.__ll.pause()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'paused'", "name": "暂停" },
    { "eval": "window.__ll.resume()" },
    { "wait": 200 },
    { "assert": "window.__ll.state.phase === 'playing'", "name": "恢复" },
    { "eval": "window.__ll.restart()" },
    { "wait": 400 },
    { "assert": "window.__ll.state.phase === 'title'", "name": "回到标题" }
  ],
  "mobile": {
    "viewport": [844, 390],
    "steps": [
      { "wait": 600 },
      { "screenshot": "07-m-title.png" },
      { "assert": "window.__ll.state.phase === 'title'", "name": "移动端标题屏" },
      { "eval": "window.__ll.debug.startSeeded(42)" },
      { "wait": 300 },
      { "assert": "window.__ll.state.phase === 'playing'", "name": "移动端进入游戏" },
      { "screenshot": "08-m-play.png" }
    ]
  },
  "checks": {
    "console": true,
    "failedRequests": true,
    "external": true
  },
  "fps": {
    "enabled": true,
    "min": 50,
    "prepare": "window.__ll.debug.startSeeded(1)"
  }
}
